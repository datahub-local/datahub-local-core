index 0000000..da0ccc8
--- /dev/null
+++ b/src/gateway-providers/litellm-proxy.ts
@@ -0,0 +1,43 @@
+/**
+ * LiteLLM proxy gateway provider (PoC).
+ *
+ * Contributes no credentials. Agents get a placeholder token and the URL of
+ * the in-cluster forwarder, which holds the LiteLLM key and adds it upstream.
+ * This keeps `validateSpec`'s "no credential values in env" rule intact
+ * instead of patching it for the PoC.
+ */
+import { registerGatewayProvider } from './gateway-provider-registry.js';
+
+const proxyUrl = process.env.NANOCLAW_LITELLM_PROXY_URL?.trim() || 'http://nanoclaw-litellm-proxy:4001';
+
+registerGatewayProvider({
+  kind: 'litellm-proxy',
+  agentSkills: [],
+  sessions: {
+    async ensure() {
+      return {
+        contribution: {
+          env: {
+            ANTHROPIC_BASE_URL: proxyUrl,
+            // The forwarder overwrites both headers. The value only has to be
+            // present; it is never a credential.
+            ANTHROPIC_AUTH_TOKEN: 'placeholder',
+            ANTHROPIC_API_KEY: 'placeholder',
+          },
+          networkAccess: { endpoint: proxyUrl, target: { kind: 'host' } },
+        },
+        async release() {
+          /* nothing per-session */
+        },
+      };
+    },
+    reapOrphans() {
+      /* nothing install-wide */
+    },
+  },
+  approvals: {
+    async subscribe() {
+      /* no approval surface in the PoC */
+    },
+  },
+});
