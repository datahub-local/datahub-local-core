+# PoC host image: the fork, built once, then copied onto the PVC at first boot.
+# Not part of upstream; see openspec/changes/add-nanoclaw-gateway.
+FROM node:22-slim
+
+ARG PNPM_VERSION=10.34.5
+ARG KUBECTL_VERSION=v1.36.2
+
+RUN apt-get update && apt-get install -y --no-install-recommends \
+      ca-certificates curl git python3 make g++ \
+    && rm -rf /var/lib/apt/lists/* \
+    && npm install -g "pnpm@${PNPM_VERSION}" \
+    && curl -fsSL -o /usr/local/bin/kubectl \
+       "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
+    && chmod +x /usr/local/bin/kubectl \
+    && kubectl version --client
+
+WORKDIR /opt/nanoclaw
+COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
+RUN pnpm install --frozen-lockfile
+COPY . .
+RUN pnpm build
+
+# The host runs as uid 1000; /opt stays root-owned and read-only to it.
+RUN chmod -R a+rX /opt/nanoclaw
