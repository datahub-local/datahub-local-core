# Domains the egress proxy may reach, keyed by squid ACL name. Everything absent
# is denied: browsing is the Firecrawl bridge's job, not the proxy's. A new
# allowlisted host is one list entry here, and the ConfigMap checksum rolls the
# proxy on the next sync.
egress_proxy_domains:
  pypi: # pip / uv
    - .pypi.org
    - pypi.python.org
    - .pythonhosted.org
  github: # git clone/push, GitHub App token minting, release assets
    - .github.com
    - .githubusercontent.com
  npm: # npm-registry access for the OpenCode CLI and its tools
    - registry.npmjs.org
  alpine: # retained: the egress ACL name predates the toolchain image
    - dl-cdn.alpinelinux.org
  slack: # Hermes' Socket Mode socket, Web API and file uploads
    - .slack.com
  # Chart resolution for the agent's own `helmfile template`. GitHub Pages chart
  # repos, Apache's release hosts, and the OCI registries the releases use; an
  # unlisted repository means the toolchain cannot render a release.
  helm:
    - .github.io
    # cloudnative-pg.github.io redirects here; the chart repo is on the target.
    - cloudnative-pg.io
    # stirling-tools.github.io redirects to this host, but over plain HTTP, which
    # the proxy denies. values/_version.yaml points at it over HTTPS instead.
    - docs.stirlingpdf.com
    - airflow.apache.org
    - downloads.apache.org
    - helm.openwebui.com
    - charts.redpanda.com
    - deploy.sympozium.ai
    - robusta-charts.storage.googleapis.com
    - ghcr.io
    - 8gears.container-registry.com
    - oci.trueforge.org
