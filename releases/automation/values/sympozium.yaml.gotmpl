# https://github.com/sympozium-ai/sympozium/blob/main/charts/sympozium/values.yaml

createNamespace: false
namespace: automation

apiserver:
  webUI:
    enabled: true
    # Pinned: left empty the chart regenerates it on every render, so ArgoCD
    # would rewrite the Secret and restart the API server on every sync.
    # Derived rather than the shared secret itself, because the UI keeps this
    # token in browser localStorage. Kept in sync with the -sympozium-login
    # middleware in ../templates/ingress_route.yaml.
    token: "{{ .StateValues.security_github_client_secret | sha256sum | trunc 32 }}"

webhook:
  replicas: 1

nats:
  # RWO PVC needs the Recreate patch in _kustomize.yaml.gotmpl to survive rollouts.
  persistence:
    enabled: true
    storageClass: longhorn
    size: 1Gi
  auth:
    enabled: false

memory:
  adminDelete:
    # Same regenerated-token problem as the UI token, with nothing to pin it to.
    enabled: false

networkPolicies:
  enabled: true
  # Reach data/ollama, which the agent allowlist does not cover. 11435 is the
  # ollama-proxy sidecar the ollama Service targets; 11434 is Ollama itself.
  extraEgressPorts:
    - 11434
    - 11435

observability:
  enabled: true
  # Chart defaults hardcode the sympozium-system namespace here.
  endpoint: "sympozium-otel-collector.automation.svc:4317"

  defaultInstance:
    otlpEndpoint: "sympozium-otel-collector.automation.svc:4317"
    resourceAttributes:
      deployment.environment: cluster
      k8s.cluster.name: "{{ .StateValues.cluster_name }}"

# Catalog is owned by ../templates/sympozium_mcp_servers.yaml so the workloads
# the controller derives from each name are prefixed.
defaultMcpServers:
  enabled: false

# https://agent-sandbox.sigs.k8s.io - the alternative execution backend, giving a
# run a Sandbox CR with a real kernel boundary instead of a plain pod.
agentSandbox:
  enabled: true
  # Matches the RuntimeClass bootstrap creates. Used when a run names none.
  defaultRuntimeClass: gvisor
  rbac: true

# Node-installed inference providers; Ollama runs in-cluster instead.
nodeProbe:
  enabled: false

llmfit:
  daemonset:
    # GPU fitness telemetry; no GPUs here.
    enabled: false

# DRA driver for model placement; needs a ghcr-pull secret that does not exist.
llmfit-dra:
  enabled: false

pricing:
  # OpenRouter is absent from the chart's shipped table (openai, anthropic,
  # bedrock only), so homelab-oracle's runs get no cost estimate without this.
  extraEntries:
    - provider: openrouter
      match: deepseek/deepseek-v4-flash-0731
      inputPerMTokMicro: 65000
      outputPerMTokMicro: 180000
