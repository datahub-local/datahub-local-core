# https://github.com/jyje/hermes-agent-helm/pull/405/blob/main/charts/hermes-agent/values-hardened.yaml

# The chart appends its own name when the release name does not contain it, which
# would name every object ...-automation-hermes-hermes-agent.
fullnameOverride: "{{ .Values.release_name }}-automation-hermes"

image:
  repository: nousresearch/hermes-agent
  # The chart's appVersion tracks the same release; the tag stays in
  # values/_version.yaml so Renovate sees it.
  tag: '{{ range $key,$value := .StateValues.container_image_version }}{{ if (eq $key "nousresearch/hermes-agent") }}{{ $value }}{{ end }}{{ end }}'

controller:
  type: deployment
replicaCount: 1
runtimeClassName: gvisor

# Velero fs-backup of the `data` volume through the daily schedule. A raw copy of
# a live HERMES_HOME is tearable (SQLite runs in WAL mode), so the pre-hook writes
# hermes' own sqlite-consistent archive into backups/, which the zip format excludes
# from itself and -k prunes to three.
podLabels:
  backup.velero.io/custom-backup-daily-fs: "true"
podAnnotations:
  backup.velero.io/backup-volumes: data
  pre.hook.backup.velero.io/command: '["/bin/sh", "-c", "mkdir -p /opt/data/backups && hermes backup -o /opt/data/backups/hermes-backup-$(date +%Y%m%d-%H%M%S).zip -k 3"]'
  pre.hook.backup.velero.io/timeout: 15m

# values-hardened.yaml, copied because the chart ships it as a file next to the
# chart, not as a values source at install time.
podSecurityContext:
  runAsNonRoot: true
  runAsUser: 10000
  runAsGroup: 10000
  fsGroup: 10000
  seccompProfile:
    type: RuntimeDefault

securityContext:
  allowPrivilegeEscalation: false
  readOnlyRootFilesystem: true
  capabilities:
    drop: [ALL]

# s6-overlay's own init lives under /run and must be executable, so the rootfs
# cannot be read-only without these.
extraVolumes:
  - name: run-tmpfs
    emptyDir:
      medium: Memory
      sizeLimit: 16Mi
  - name: tmp-tmpfs
    emptyDir:
      medium: Memory
      sizeLimit: 64Mi
  - name: slack-eyes-ack
    configMap:
      name: '{{ .Values.release_name }}-automation-hermes-slack-eyes-ack'

extraVolumeMounts:
  - name: run-tmpfs
    mountPath: /run
  - name: tmp-tmpfs
    mountPath: /tmp
  - name: slack-eyes-ack
    mountPath: /opt/data/plugins/slack-eyes-ack
    readOnly: true

# seed-config's chown only runs when that init container starts as root; the
# hardened profile starts it as 10000, so the Longhorn mountpoint stays
# root-owned. Hermes refuses to discover the gateway through a HERMES_HOME it
# does not own (unsafe_control_path), and since v0.22.5 a dashboard chat is
# profile-scoped ("default" is this same directory), so the TUI never takes the
# attach URL and every chat retries for a minute instead. Only the mountpoint
# is root-owned; everything inside is already 10000.
extraInitContainers:
  - name: chown-data
    image: '{{ range $key,$value := .StateValues.container_image_version }}{{ if (eq $key "nousresearch/hermes-agent") }}nousresearch/hermes-agent:{{ $value }}{{ end }}{{ end }}'
    imagePullPolicy: IfNotPresent
    command: ["chown", "10000:10000", "/opt/data"]
    securityContext:
      runAsNonRoot: false
      runAsUser: 0
      runAsGroup: 0
      allowPrivilegeEscalation: false
      readOnlyRootFilesystem: true
      capabilities:
        drop: [ALL]
        add: [CHOWN]
    volumeMounts:
      - name: data
        mountPath: /opt/data

# seed-config copies config.yaml only when it is absent, so a new key never
# reaches an existing volume. Adding one (mcp_servers was the first) needs a
# deploy with `bootstrap.overwrite=true`; it stays false so runtime edits to
# config.yaml survive later rollouts.

persistence:
  enabled: true
  storageClass: longhorn
  size: 10Gi

soul:
  # Seeded only when HERMES_HOME/SOUL.md is absent (bootstrap.overwrite stays
  # false), so the running volume keeps its edits. A fresh volume gets the
  # identity plus the Firecrawl routing rule below.
  text: |
    You are Hermes Agent, built by Nous Research. Be direct: match the length of your reply to the weight of the ask — a one-line question gets a one-line answer, and finished work gets a short report of what changed, what's verified, and what's left, never a replay of the process. No filler ("Great question," "I'd be happy to"), no restating the request back, no re-summarizing what you already said, no narrating tool calls the user can see. Plain claims over adjectives; when unsure, say so plainly. Agree because it's right, not because the user said it. Depth is earned — give it when the user asks for detail, teaches, or the stakes demand it, not by default.

    ## Web access
    For any web page or URL, use the Firecrawl tools: `firecrawl_scrape` (one URL), `firecrawl_search` (discover pages), `firecrawl_map` (list a site's URLs). Do not fetch pages with `curl`, `wget`, or other shell HTTP clients unless the user explicitly asks for raw HTTP.

config:
  providers:
    litellm:
      base_url: http://{{ .Values.release_name }}-data-litellm.data.svc.cluster.local:4000/v1
      key_env: OPENAI_API_KEY
      discover_models: true
  model:
    provider: litellm
    default: opencode-go/deepseek-v4.1-flash
  terminal:
    backend: local
  # Sympozium's MCP servers already run in this namespace and their stdio
  # adapter serves MCP over HTTP on 8080. `slack` here is an extra tool surface,
  # distinct from the built-in channel, which keeps its own Socket Mode socket.
  mcp_servers:
    sympozium-k8s:
      url: http://{{ .Values.release_name }}-automation-mcp-k8s.automation.svc.cluster.local:8080/mcp
    sympozium-argocd:
      url: http://{{ .Values.release_name }}-automation-mcp-argocd.automation.svc.cluster.local:8080/mcp
    sympozium-github:
      url: http://{{ .Values.release_name }}-automation-mcp-github-hermes.automation.svc.cluster.local:8080/mcp
      headers:
        # Expanded when the gateway loads config.yaml, so no token lands in the
        # ConfigMap; extraEnvFrom supplies GITHUB_PERSONAL_ACCESS_TOKEN.
        Authorization: "Bearer ${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
    sympozium-grafana:
      url: http://{{ .Values.release_name }}-automation-mcp-grafana.automation.svc.cluster.local:8080/mcp
    sympozium-postgres:
      url: http://{{ .Values.release_name }}-automation-mcp-postgres.automation.svc.cluster.local:8080/mcp
    sympozium-trino:
      url: http://{{ .Values.release_name }}-automation-mcp-trino.automation.svc.cluster.local:8080/mcp
    sympozium-slack:
      url: http://{{ .Values.release_name }}-automation-mcp-slack.automation.svc.cluster.local:8080/mcp
    sympozium-firecrawl:
      # The server's own stateless HTTP transport, not the stdio bridge: the
      # bridge misroutes replies for this server (a call can hang to timeout).
      url: http://{{ .Values.release_name }}-automation-mcp-firecrawl-http.automation.svc.cluster.local:8080/mcp
      # FastMCP stateless mode closes the GET event stream, which Hermes reads as
      # a failed keepalive and tears down the transport mid-call. The transport
      # has no session to refresh, so keep the probe out of normal use.
      keepalive_interval: 3600
      # toolsAllow only filters what Sympozium registers for its own agents.
      # Hermes connects directly, so it needs its own include list.
      tools:
        include:
          - firecrawl_scrape
          - firecrawl_search
          - firecrawl_map
  # The built-in web and browser toolsets stay off on every surface, not only
  # Slack. platform_toolsets is per platform, so CLI and dashboard chats kept
  # web_extract; this list is the global suppression applied last. Firecrawl is
  # the web surface.
  agent:
    disabled_toolsets:
      - web
      - browser
  # `hermes tools disable web browser --platform slack` wrote this list; the
  # defaults stay out of config.yaml. Firecrawl is the web surface instead.
  platform_toolsets:
    slack:
      - clarify
      - code_execution
      - computer_use
      - connections
      - cronjob
      - delegation
      - file
      - image_gen
      - memory
      - session_search
      - skills
      - terminal
      - todo
      - tts
      - vision
  security:
    redact_secrets: true
  # The ack reaction is a plugin (template hermes_slack_eyes_ack.yaml) and this
  # only selects it: seed-config writes config.yaml on a fresh volume only, so an
  # existing volume keeps whatever `hermes config set` last wrote.
  plugins:
    enabled:
      - slack-eyes-ack
    entries:
      slack-eyes-ack:
        settings:
          emoji: eyes
  approvals:
    mode: smart
    cron_mode: deny
    unattended_mode: deny
    single_query_mode: deny
  dashboard:
    oauth:
      self_hosted:
        # Dex staticClient "hermes"; the secret is shared with the other apps and
        # arrives through HERMES_DASHBOARD_OIDC_CLIENT_SECRET below, never here.
        issuer: https://security-dex.{{ .StateValues.gateway_hostname }}/dex
        client_id: hermes

dashboard:
  enabled: true
  publicUrl: https://automation-hermes.{{ .StateValues.gateway_hostname }}
  # Traefik runs hostNetwork, so the peer is a node address; the pod CIDR covers
  # a controller reaching the pod from its tunnel address.
  trustedProxies:
    - 192.168.31.0/24
    - 10.42.0.0/16
  auth:
    provider: oidc

service:
  enabled: true

# A null deletes the chart's default sk-REPLACE_ME; an empty map would keep it.
# The real key comes from litellm-auth-credentials in extraEnvFrom below, which
# is applied after the chart's own Secret and wins the duplicate name.
env:
  OPENAI_API_KEY: null

extraEnvFrom:
  - secretRef:
      name: litellm-auth-credentials
  # Hermes has its own Slack app: the @homelab app is held by Sympozium's channel
  # responder, and Slack gives each event to one of an app's Socket Mode
  # connections, so a shared app means Hermes never receives anything.
  - secretRef:
      name: hermes-slack-token
  # The dedicated github HTTP instance takes the token as a request header, and
  # Hermes expands `${env:GITHUB_PERSONAL_ACCESS_TOKEN}` from this.
  - secretRef:
      name: mcp-github-token

extraEnv:
  - name: GATEWAY_ALLOW_ALL_USERS
    value: "false"
  - name: SLACK_ALLOWED_USERS
    value: U08RV08387L
  # Hermes has its own Slack app (@homelab_hermes): the @homelab app is held by
  # Sympozium's channel responder and Slack splits one app's events across its
  # Socket Mode connections. #agent-hermes is Hermes's channel: it answers plain
  # messages there, which the responder's trigger set ignores.
  - name: SLACK_ALLOWED_CHANNELS
    value: C0CBX92B6PQ
  - name: SLACK_FREE_RESPONSE_CHANNELS
    value: C0CBX92B6PQ
  # The app has no /hermes slash command registered, so /hermes sethome cannot
  # run; cron and cross-platform results need the home channel from the env.
  - name: SLACK_HOME_CHANNEL
    value: C0CBX92B6PQ
  # Same dex client secret as the other apps; config.yaml is a ConfigMap, so
  # the secret cannot live in config.dashboard.oauth.self_hosted.
  - name: HERMES_DASHBOARD_OIDC_CLIENT_SECRET
    value: "{{ .StateValues.security_github_client_secret }}"
  # The image sets PYTHONDONTWRITEBYTECODE=1, so every CLI/PTY start recompiles
  # the 2.1 GB tree from source; a dashboard resume spawns a new process each
  # time. A bytecode cache on the volume took a cold start's import from ~10 s
  # to ~3 s. The path must stay outside the read-only rootfs.
  - name: PYTHONDONTWRITEBYTECODE
    value: "0"
  - name: PYTHONPYCACHEPREFIX
    value: /opt/data/.pycache

# The gVisor RuntimeClass already pins datahub.local/gvisor; this adds the arch
# because the agent's start-up is CPU-bound and the amd64 nodes are far faster
# than the Pis.
# amd-2 is excluded by name: its kernel blacklists the TSC (clocksource is hpet
# only) while gVisor still drives the sandbox clock from it, so CLOCK_MONOTONIC
# there jumps back by up to 1.6 s and Node's GetNowUint64 CHECK_GE aborts the
# dashboard chat TUI. amd-1 reports tsc as its clocksource and is clean.
nodeSelector:
  kubernetes.io/arch: amd64
  kubernetes.io/hostname: datahublocal-amd-1

networkPolicy:
  enabled: true
  allowDns: true
  # Denies the rest of RFC1918 and the metadata endpoint; the LiteLLM rule below
  # is the only in-cluster egress exception, so the agent cannot reach the API
  # server.
  blockPrivateEgress: true
  extraEgress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: data
          podSelector:
            matchLabels:
              app.kubernetes.io/name: litellm
      ports:
        - protocol: TCP
          port: 4000
    # dex is published through Traefik, which runs hostNetwork, so the issuer
    # resolves to a node address inside RFC1918 and OIDC discovery is denied
    # without this rule - the dashboard then answers 503 on /auth/login.
    - to:
        - ipBlock:
            cidr: 192.168.31.0/24
      ports:
        - protocol: TCP
          port: 443
    # Sympozium's MCP servers in this namespace, addressed by the pod label the
    # controller puts on all of them; the stdio adapter is plain HTTP on 8080.
    - to:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: mcpserver
      ports:
        - protocol: TCP
          port: 8080
  # Only the dashboard listener is reachable, and only from Traefik's node
  # addresses (hostNetwork, so a namespace/pod selector would match nothing).
  # The pod CIDR is required too: under gVisor a peer on another node arrives
  # SNATed to the pod network's gateway address, so a node-only rule left every
  # Traefik replica except the one on this node answering 502.
  extraIngress:
    - from:
        - ipBlock:
            cidr: 192.168.31.0/24
        - ipBlock:
            cidr: 10.42.0.0/16
      ports:
        - protocol: TCP
          port: 9119

# `hermes gateway status` answers correctly but takes ~35s inside this Pod, too
# slow for a probe. s6 supervises the gateway, so its own service state is the
# cheap equivalent; readiness also waits for the dashboard listener so Traefik
# does not answer 502 during the first, skill-syncing boot. The service path is
# image-specific, and the image tag is pinned.
probes:
  startup:
    exec:
      command:
        - /command/s6-svstat
        - /run/service/main-hermes
    periodSeconds: 5
    timeoutSeconds: 5
    failureThreshold: 60
  liveness:
    exec:
      command:
        - /command/s6-svstat
        - /run/service/main-hermes
    periodSeconds: 30
    timeoutSeconds: 5
    failureThreshold: 3
  readiness:
    exec:
      command:
        - /bin/sh
        - -c
        - /command/s6-svstat /run/service/main-hermes && curl -fsS -o /dev/null http://127.0.0.1:9119/
    periodSeconds: 10
    timeoutSeconds: 5
    failureThreshold: 3
