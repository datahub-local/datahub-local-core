# Patches to chart-rendered resources. New resources go in ../templates/;
# kustomize can only modify, not add.
#{{- $release_name := (readFile "../../../values/global.yaml.gotmpl" | fromYaml).release_name }}

kustomize:
  sympozium:
    # NATS keeps its JetStream store on a RWO PVC; RollingUpdate deadlocks on reattach.
    - apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: nats
        namespace: automation
        annotations:
          # A merge cannot drop the defaulted rollingUpdate that Recreate forbids.
          argocd.argoproj.io/sync-options: Replace=true
      spec:
        strategy:
          type: Recreate
  hermes:
    # The chart's NetworkPolicy always renders a public egress rule and no value
    # removes it; NetworkPolicies only add, so a second policy cannot deny it.
    # Replace the whole egress list instead: DNS, the MCP pods, LiteLLM, the
    # security proxy and dex, with no public rule. Ingress stays in hermes.yaml.
    - target:
        version: v1
        kind: NetworkPolicy
        name: '{{ $release_name }}-automation-hermes'
      patch:
        - op: replace
          path: /spec/egress
          value:
            - to:
                - namespaceSelector:
                    matchLabels:
                      kubernetes.io/metadata.name: kube-system
                  podSelector:
                    matchLabels:
                      k8s-app: kube-dns
              ports:
                - protocol: UDP
                  port: 53
                - protocol: TCP
                  port: 53
            - to:
                - podSelector:
                    matchLabels:
                      app.kubernetes.io/name: mcpserver
              ports:
                - protocol: TCP
                  port: 8080
            - to:
                - namespaceSelector:
                    matchLabels:
                      kubernetes.io/metadata.name: data
                  podSelector:
                    matchLabels:
                      app.kubernetes.io/name: litellm
              ports:
                - protocol: TCP
                  port: 4000
            - to:
                - namespaceSelector:
                    matchLabels:
                      kubernetes.io/metadata.name: security
                  podSelector:
                    matchLabels:
                      app.kubernetes.io/name: '{{ $release_name }}-security-egress-proxy'
              ports:
                - protocol: TCP
                  port: 3128
            - to:
                - ipBlock:
                    cidr: 192.168.31.0/24
              ports:
                - protocol: TCP
                  port: 443
