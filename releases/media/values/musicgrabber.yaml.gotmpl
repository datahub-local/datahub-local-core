# https://github.com/bjw-s-labs/helm-charts/blob/main/charts/library/common/values.yaml
# https://gitlab.com/g33kphr33k/musicgrabber

controllers:
  main:
    strategy: Recreate
    annotations:
      reloader.stakater.com/auto: "true"
    pod:
      dnsPolicy: "ClusterFirst"
      hostNetwork: true
    serviceAccount:
      identifier: default
    containers:
      main:
        image:
          repository: g33kphr33k/musicgrabber
          tag: '{{ range $key,$value := .StateValues.container_image_version }}{{ if (eq $key "g33kphr33k/musicgrabber") }}{{ $value }}{{ end }}{{ end }}'
        env:
          MUSIC_DIR: /music
          DB_PATH: /data/music_grabber.db
          ENABLE_MUSICBRAINZ: true
          ENABLE_LYRICS: true
          DEFAULT_CONVERT_TO_FLAC: true
          SINGLES_SUBDIR: Singles
          PLAYLISTS_SUBDIR: Playlists
          ORGANISE_BY_ARTIST: false
          LISTEN_ADDR: 0.0.0.0
          LISTEN_PORT: 8080
          INCLUDE_TRACK_NUMBER_IN_FILENAME: true
        resources:
          requests:
            memory: 500Mi
            cpu: 500m
          limits:
            memory: 2Gi
            cpu: 1
        probes:
          liveness:
            enabled: true
          readiness:
            enabled: true
          startup:
            enabled: true
            spec:
              failureThreshold: 30
              periodSeconds: 5

persistence:
  data:
    type: persistentVolumeClaim
    accessMode: ReadWriteOnce
    storageClass: longhorn
    size: 128Mi
    globalMounts:
      - path: /data
  # Music library on the NAS NFS export, so the pod is not pinned to a node.
  # The media-musicgrabber directory already exists on the NAS export.
  #
  # To browse/copy the library from the laptop:
  #
  #   a) From WSL - REQUIRES networkingMode=nat in %USERPROFILE%\.wslconfig.
  #      With networkingMode=mirrored the kernel NFS client hangs forever in
  #      SYN-SENT (mirrored mode never delivers the replies to the kernel's RPC
  #      sockets, even though userspace TCP to the NAS works fine), so a plain
  #      `sudo mount -t nfs ...` just looks stuck. After editing .wslconfig run
  #      `wsl --shutdown`, then:
  #
  #        sudo apt install -y nfs-common
  #        sudo mkdir -p /mnt/nfs-musicgrabber
  #        sudo mount -t nfs -o vers=4,rw,hard,noatime \
  #          datahublocal-nas:/mnt/main/nfs/k8s/media-musicgrabber /mnt/nfs-musicgrabber
  #
  #      persist it in /etc/fstab:
  #        datahublocal-nas:/mnt/main/nfs/k8s/media-musicgrabber /mnt/nfs-musicgrabber nfs vers=4,rw,hard,noatime,_netdev 0 0
  #
  #      Windows Explorer sees this only as \\wsl.localhost\<distro>\mnt\nfs-musicgrabber,
  #      NOT as %USERPROFILE%\Music\musicgrabber.
  #
  #   b) For a real Windows path, use the Windows NFS client instead.
  #      Install it once from an ELEVATED PowerShell (Win 11 Pro; reboot if asked).
  #      Enable the CHILD feature: the umbrella "ServicesForNFS-ClientOnly" already
  #      reports itself installed and silently no-ops, without ever laying down
  #      mount.exe or the NfsClnt service:
  #
  #        Enable-WindowsOptionalFeature -Online -FeatureName ClientForNFS-Infrastructure -All
  #        Enable-WindowsOptionalFeature -Online -FeatureName NFS-Administration -All
  #
  #      then, from a normal PowerShell - it MUST be `mount.exe`, because plain
  #      `mount` is a PowerShell alias for New-PSDrive and fails with
  #      "the parameter name 'o' is ambiguous":
  #
  #        mount.exe -o anon \\datahublocal-nas\mnt\main\nfs\k8s\media-musicgrabber Z:
  #
  #      Link it into the profile ONCE, from an ELEVATED cmd - symlink creation
  #      needs admin (both `mklink /D` and `New-Item -ItemType SymbolicLink` refuse
  #      without it, and `mklink /J` cannot target a network drive). The symlink is
  #      a permanent filesystem object: it survives reboots and merely dangles
  #      until Z: is mounted again, so this is a one-time step:
  #
  #        mklink /D "%USERPROFILE%\Music\musicgrabber" Z:\
  #
  #      or self-elevating, from a normal PowerShell:
  #
  #        Start-Process cmd -Verb RunAs -ArgumentList '/c','mklink /D "%USERPROFILE%\Music\musicgrabber" Z:\'
  #
  #      The Z: mount itself is per-logon-session and does NOT survive a reboot,
  #      so re-create it at logon from
  #      %APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup\mount-musicgrabber.cmd:
  #
  #        @echo off
  #        set SHARE=\\datahublocal-nas\mnt\main\nfs\k8s\media-musicgrabber
  #        if exist Z:\ exit /b 0
  #        C:\Windows\System32\mount.exe -o anon %SHARE% Z: >nul 2>&1
  #        if exist Z:\ exit /b 0
  #        rem NfsClnt/NfsRdr may still be starting right after logon - retry once
  #        timeout /t 15 /nobreak >nul
  #        C:\Windows\System32\mount.exe -o anon %SHARE% Z: >nul 2>&1
  #
  #      If it lands read-only, map anon to the export owner (elevated, then
  #      `Restart-Service NfsClnt`):
  #        $k='HKLM:\SOFTWARE\Microsoft\ClientForNFS\CurrentVersion\Default'
  #        New-ItemProperty -Path $k -Name AnonymousUid -Value 950 -PropertyType DWord -Force
  #        New-ItemProperty -Path $k -Name AnonymousGid -Value 950 -PropertyType DWord -Force
  #
  #      (SMB is not an option: ports 445/139 are closed on datahublocal-nas.)
  music:
    type: nfs
    server: datahublocal-nas
    path: /mnt/main/nfs/k8s/media-musicgrabber
    globalMounts:
      - path: /music
  shm:
    type: emptyDir
    medium: Memory
    sizeLimit: 2Gi
    globalMounts:
      - path: /dev/shm

serviceAccount:
  default:
    enabled: true

service:
  main:
    controller: main
    ports:
      http:
        port: 8080

rawResources:
  main:
    manifest:
      apiVersion: traefik.io/v1alpha1
      kind: IngressRoute
      metadata:
        annotations:
          gethomepage.dev/enabled: "true"
          gethomepage.dev/name: "MusicGrabber"
          gethomepage.dev/group: "Media"
          gethomepage.dev/icon: "sh-music-service"
          gethomepage.dev/href: "https://media-musicgrabber.{{ .Values.gateway_hostname }}"
      spec:
        entryPoints:
          - websecure
        routes:
          - match: Host(`media-musicgrabber.{{ .Values.gateway_hostname }}`)
            kind: Rule
            services:
              - name: "{{ .Values.release_name }}-media-musicgrabber"
                port: http
            middlewares:
              - name: oauth2-proxy-auth
                namespace: security
          - match: Host(`media-musicgrabber.{{ .Values.gateway_hostname }}`) && PathPrefix(`/oauth2/`)
            kind: Rule
            services:
              - name: oauth2-proxy
                namespace: security
                port: http
