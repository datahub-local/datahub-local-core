#{{- $namespace := "data" }}
#{{- $release_name := (readFile "../../../values/global.yaml.gotmpl" | fromYaml).release_name }}
#{{- $metrics_image_version := index (readFile "../../../values/_version.yaml" | fromYaml).container_image_version "ghcr.io/datahub-local/ollama-metrics" }}

kustomize:
  airflow:
    - apiVersion: rbac.authorization.k8s.io/v1
      kind: Role
      metadata:
        name: "{{ $release_name }}-data-airflow-pod-launcher-role"
        namespace: "{{ $namespace }}"
      rules:
        - apiGroups:
            - "sparkoperator.k8s.io"
          resources:
            - "*"
          verbs:
            - "*"
        # Maintain sync with the permissions defined in https://github.com/apache/airflow/blob/main/chart/templates/rbac/pod-launcher-role.yaml
        - apiGroups:
            - ""
          resources:
            - "pods"
          verbs:
            - "create"
            - "list"
            - "get"
            - "patch"
            - "watch"
            - "delete"
        - apiGroups:
            - ""
          resources:
            - "pods/log"
          verbs:
            - "get"
        - apiGroups:
            - ""
          resources:
            - "pods/exec"
          verbs:
            - "create"
            - "get"
        - apiGroups:
            - ""
          resources:
            - "events"
          verbs:
            - "list"
            - "watch"
        - apiGroups:
            - ""
          resources:
            - "secrets"
          verbs:
            - "get"
            - "list"
            - "watch"
        - apiGroups:
            - "batch"
          resources:
            - "jobs"
          verbs:
            - "create"
            - "list"
            - "get"
            - "patch"
            - "watch"
            - "delete"
        - apiGroups:
            - "batch"
          resources:
            - "jobs/status"
          verbs:
            - "get"
  ollama:
    # Transparent proxy in front of Ollama; the chart has no sidecar hook.
    - apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: "{{ $release_name }}-data-ollama"
        namespace: "{{ $namespace }}"
      spec:
        template:
          spec:
            containers:
              - name: metrics-proxy
                image: "ghcr.io/datahub-local/ollama-metrics:{{ $metrics_image_version }}"
                imagePullPolicy: IfNotPresent
                env:
                  # hostNetwork: the sidecar shares the node netns with Ollama.
                  - name: OLLAMA_HOST
                    value: "http://localhost:11434"
                  - name: PORT
                    value: "11435"
                  - name: DEBUG_MODE
                    value: "true"
                  # Must be set to be compatible with Sympozium
                  - name: OLLAMA_PROXY_REQUEST_OVERRIDES
                    value: '{"reasoning_effort":"none"}'
                ports:
                  - name: metrics-proxy
                    containerPort: 11435
                    protocol: TCP
                readinessProbe:
                  httpGet:
                    path: /metrics
                    port: 11435
                  periodSeconds: 30
                resources:
                  requests:
                    cpu: 10m
                    memory: 32Mi
                  limits:
                    memory: 128Mi
                securityContext:
                  allowPrivilegeEscalation: false
                  readOnlyRootFilesystem: true
                  runAsNonRoot: true
                  runAsUser: 65534
                  capabilities:
                    drop:
                      - ALL

  # Keeps the service on 11434 but lands it on the sidecar, which forwards to
  # Ollama. A strategic merge cannot rewrite a servicePort entry it has matched.
  ollama_json_patches:
    - target:
        version: v1
        kind: Service
        name: "{{ $release_name }}-data-ollama"
        namespace: "{{ $namespace }}"
      patch:
        - op: replace
          path: /spec/ports/0/targetPort
          value: metrics-proxy
