# https://github.com/trinodb/charts/blob/main/charts/trino/values.yaml
imagePullSecrets: []

server:
  workers: 1

  autoscaling:
    enabled: true
    maxReplicas: 3
    targetCPUUtilizationPercentage: 75
    # Worker JVM RSS stays near maxHeapSize regardless of load, so memory
    # utilization is not a usable scaling signal.
    targetMemoryUtilizationPercentage: ""

  log:
    trino:
      level: INFO

  coordinatorExtraConfig: |
    web-ui.enabled=true
    web-ui.authentication.type=FIXED
    web-ui.user=admin
    http-server.process-forwarded=IGNORE

additionalConfigProperties:
  - "internal-communication.shared-secret={{ .StateValues.security_github_client_id }}"

coordinator:
  # heap must stay below the memory limit minus JVM native overhead
  jvm:
    maxHeapSize: "2G"

  resources:
    requests:
      cpu: 500m
      memory: 2Gi
    limits:
      cpu: 1
      memory: 3Gi

  nodeSelector:
    kubernetes.io/arch: arm64

worker:
  # heap must stay below the memory limit minus JVM native overhead
  jvm:
    maxHeapSize: "3G"

  # The HPA needs a CPU request to compute utilization.
  resources:
    requests:
      cpu: 500m
      memory: 3Gi
    limits:
      cpu: 2
      memory: 4Gi

  nodeSelector:
    kubernetes.io/arch: arm64

# Coordinator initContainer: ensures Polaris catalogs exist before Trino starts.
# Gracefully skips if Polaris is not yet bootstrapped (bootstrap job handles first-time setup).
initContainers:
  coordinator:
    - name: setup-polaris-catalogs
      image: 'curlimages/curl:{{ range $key,$value := .StateValues.container_image_version }}{{ if (eq $key "curlimages/curl") }}{{ $value }}{{ end }}{{ end }}'
      command:
        - /bin/sh
        - -c
        - |
          POLARIS_URL="http://{{ $.Values.release_name }}-data-polaris:8181"

          echo "Waiting for Polaris..."
          until curl -s -o /dev/null --max-time 5 "$POLARIS_URL/api/catalog"; do
            sleep 5
          done

          TOKEN=$(curl -sf -X POST "$POLARIS_URL/api/catalog/v1/oauth/tokens" \
            -H "Content-Type: application/x-www-form-urlencoded" \
            -d "grant_type=client_credentials&client_id=root&client_secret=${POLARIS_CLIENT_SECRET}&scope=PRINCIPAL_ROLE:ALL" \
            2>/dev/null | tr ',' '\n' | grep 'access_token' | cut -d'"' -f4 || true)

          if [ -n "$TOKEN" ]; then
            {{- range $key, $value := .Values.iceberg_catalogs }}
            curl -s -o /dev/null -X POST "$POLARIS_URL/api/management/v1/catalogs" \
              -H "Authorization: Bearer $TOKEN" \
              -H "Content-Type: application/json" \
              -d '{"catalog":{"name":"{{ $key }}","type":"INTERNAL","properties":{"default-base-location":"s3://datahub-local-{{ $key }}"},"storageConfigInfo":{"storageType":"S3","allowedLocations":["s3://datahub-local-{{ $key }}"]}}}' || true
            {{- end }}
          else
            echo "Polaris not yet bootstrapped, skipping catalog creation."
          fi
      env:
        - name: POLARIS_CLIENT_SECRET
          value: "{{ .StateValues.security_github_client_secret }}"

serviceAccount:
  create: true

# Deny-by-default: a user matching no rule loses every catalog. No group provider
# is configured, so tiers are anchored `user` alternations.
# system stays reachable when no rule matches it, unlike every other catalog, so
# each tier pins it explicitly -- read-only, since clients introspect it.
# A non-empty functions section disables built-ins for everyone not granted them,
# hence the system.builtin grant per tier.
accessControl:
  type: configmap
  configFile: rules.json
  # Rules reload in place, so edits need no coordinator restart.
  refreshPeriod: 60s
  rules:
    rules.json: |-
      {{- $readers := printf "^(%s)$" (.Values.trino_reader_users | join "|") }}
      {{- $writers := printf "^(%s)$" (.Values.trino_writer_users | join "|") }}
      {{- $admins := printf "^(%s)$" (append .Values.trino_admin_extra_users .StateValues.default_admin_user | join "|") }}
      {{- $iceberg := keys .Values.iceberg_catalogs | sortAlpha | join "|" }}
      {
        "catalogs": [
          {"user": "{{ $admins }}", "catalog": ".*", "allow": "all"},
          {"user": "{{ $writers }}", "catalog": "system", "allow": "read-only"},
          {{- /* postgresql_* excluded: shared viewer credential. */}}
          {"user": "{{ $writers }}", "catalog": "^(memory|{{ $iceberg }})$", "allow": "all"},
          {"user": "{{ $readers }}", "catalog": "system", "allow": "read-only"},
          {"user": "{{ $readers }}", "catalog": "^(memory|postgresql_.*|{{ $iceberg }})$", "allow": "read-only"}
        ],
        "schemas": [
          {"user": "{{ $admins }}", "schema": ".*", "owner": true},
          {{- /* owner: writers create and drop schemas, not just tables. */}}
          {"user": "{{ $writers }}", "catalog": "^(memory|{{ $iceberg }})$", "schema": ".*", "owner": true}
        ],
        "queries": [
          {"user": "{{ $admins }}", "allow": ["execute", "view", "kill"]},
          {"user": "{{ $writers }}", "allow": ["execute"]},
          {"user": "{{ $readers }}", "allow": ["execute"]}
        ],
        "functions": [
          {"user": "{{ $admins }}", "catalog": ".*", "schema": ".*", "function": ".*", "privileges": ["EXECUTE", "GRANT_EXECUTE", "OWNERSHIP"]},
          {"user": "{{ $writers }}", "catalog": "system", "schema": "builtin", "function": ".*", "privileges": ["EXECUTE"]},
          {"user": "{{ $readers }}", "catalog": "system", "schema": "builtin", "function": ".*", "privileges": ["EXECUTE"]}
        ],
        "procedures": [
          {"user": "{{ $admins }}", "catalog": ".*", "schema": ".*", "procedure": ".*", "privileges": ["EXECUTE", "GRANT_EXECUTE"]}
        ],
        "system_information": [
          {"user": "{{ $admins }}", "allow": ["read"]}
        ]
      }

env:
  - name: "POLARIS_OAUTH_CREDENTIAL"
    value: "root:{{ .StateValues.security_github_client_secret }}"
  - name: "S3_AWS_ACCESS_KEY"
    valueFrom:
      secretKeyRef:
        name: s3-credentials
        key: accessKey
  - name: "S3_AWS_SECRET_KEY"
    valueFrom:
      secretKeyRef:
        name: s3-credentials
        key: secretKey
  - name: "POSTGRES_VIEWER_USER"
    valueFrom:
      secretKeyRef:
        name: postgresql-viewer-credentials
        key: username
  - name: "POSTGRES_VIEWER_PASSWORD"
    valueFrom:
      secretKeyRef:
        name: postgresql-viewer-credentials
        key: password

additionalCatalogs:
  memory: |
    connector.name=memory
    memory.max-data-per-node=128MB
  # {{- range $key, $value := .Values.postgres_extra_databases }}
  # Direct service: the JDBC connector is incompatible with the transaction-mode pooler.
  postgresql_{{ $key }}: |
    connector.name=postgresql
    connection-url=jdbc:postgresql://{{ $.Values.release_name }}-data-postgresql-r:5432/{{ $value }}
    connection-user=${ENV:POSTGRES_VIEWER_USER}
    connection-password=${ENV:POSTGRES_VIEWER_PASSWORD}
    case-insensitive-name-matching=true
  # {{- end }}
  # {{- range $key, $value := .Values.iceberg_catalogs }}
  {{ $key }}: |
    connector.name=iceberg
    iceberg.catalog.type=rest
    iceberg.rest-catalog.uri=http://{{ $.Values.release_name }}-data-polaris:8181/api/catalog
    iceberg.rest-catalog.warehouse={{ $key }}
    iceberg.rest-catalog.prefix={{ $key }}
    iceberg.rest-catalog.security=OAUTH2
    iceberg.rest-catalog.oauth2.credential=${ENV:POLARIS_OAUTH_CREDENTIAL}
    iceberg.rest-catalog.oauth2.scope=PRINCIPAL_ROLE:ALL
    iceberg.rest-catalog.vended-credentials-enabled=false

    fs.native-s3.enabled=true
    s3.aws-access-key=${ENV:S3_AWS_ACCESS_KEY}
    s3.aws-secret-key=${ENV:S3_AWS_SECRET_KEY}
    s3.endpoint=https://{{ $.Values.s3_endpoint }}
    s3.region=homelab
    s3.path-style-access=true
  # {{- end }}
