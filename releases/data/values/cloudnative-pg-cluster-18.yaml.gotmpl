# https://github.com/cloudnative-pg/charts/blob/main/charts/cluster/values.yaml

type: postgresql

cluster:
  imageName: "ghcr.io/cloudnative-pg/postgresql:18.1-system-trixie"

  instances: 2

  # Spread the instances so either node can be drained for maintenance while the
  # cluster keeps serving. The chart default (topology.kubernetes.io/zone)
  # matches no node here, which leaves both instances free to land together.
  affinity:
    topologyKey: kubernetes.io/hostname
    # Hard, so the two instances can never share a node and a drain can never
    # take both down at once.
    podAntiAffinityType: required

  resources:
    limits:
      cpu: "1"
      memory: 4Gi
    requests:
      cpu: "1"
      memory: 4Gi

  storage:
    size: 8Gi
    storageClass: "longhorn"

  walStorage:
    enabled: true
    size: 4Gi
    storageClass: "longhorn"

  enableSuperuserAccess: true
  superuserSecret: "postgresql-admin-credentials"

  env:
    - name: AWS_DEFAULT_REGION
      value: "homelab"
    - name: AWS_REQUEST_CHECKSUM_CALCULATION
      value: "WHEN_REQUIRED"
    - name: AWS_RESPONSE_CHECKSUM_VALIDATION
      value: "WHEN_REQUIRED"

  monitoring:
    enabled: true
    # CNPGClusterHACritical stays on: it means the cluster has no standby left.
    # CNPGClusterHAWarning stays off because it wants two standbys, so two
    # instances would trip it permanently.
    prometheusRule:
      excludeRules:
        - CNPGClusterHAWarning

  # Read-only role for Trino; pg_read_all_data grants SELECT cluster-wide.
  roles:
    - name: viewer
      ensure: present
      comment: Read-only user for Trino
      connectionLimit: -1
      login: true
      superuser: false
      createdb: false
      createrole: false
      inRoles:
        - pg_read_all_data
      inherit: true
      passwordSecret:
        name: postgresql-viewer-credentials

poolers:
  - name: rw
    type: rw
    poolMode: transaction
    instances: 2
    parameters:
      max_client_conn: "1000"
      default_pool_size: "25"
    monitoring:
      enabled: true
      podMonitor:
        enabled: true

databases:
  # {{- range $key, $value := .Values.postgres_extra_databases }}
  - name: "{{ $value }}"
    ensure: "present"
    owner: "app"
  # {{- end }}

backups:
  enabled: true

  endpointURL: "https://{{ .Values.s3_gdrive_endpoint }}"
  provider: s3
  s3:
    bucket: "{{ $.Values.backup_s3_bucket }}"
    path: "/postgresql-cn"
  secret:
    create: false
    name: backup-cloudnative-pg-auth

  wal:
    encryption:
  data:
    encryption:

  scheduledBackups:
    - name: daily-backup # Daily at midnight
      schedule: "0 0 0 * * *" # Daily at midnight
      backupOwnerReference: self
      method: barmanObjectStore
  retentionPolicy: "30d"
#################################################
