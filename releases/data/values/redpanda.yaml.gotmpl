# https://github.com/redpanda-data/redpanda-operator/blob/main/charts/console/chart/values.yaml
# https://github.com/redpanda-data/redpanda-operator/blob/main/charts/redpanda/chart/values.yaml

config:
  node:
    crash_loop_limit: 10
    crash_loop_sleep_sec: 120
  cluster:
    auto_create_topics_enabled: true
    # Enterprise-only balancing features: brokers >= v26.2 refuse to start when
    # these are enabled without a license, so keep them pinned to the OSS values.
    partition_autobalancing_mode: node_add
    core_balancing_continuous: false

tls:
  enabled: false

statefulset:
  replicas: 3

resources:
  cpu:
    cores: 1
  memory:
    container:
      max: 2.5Gi

storage:
  persistentVolume:
    storageClass: longhorn-no-replica
    size: 2Gi

monitoring:
  enabled: true

  enableHttp2: true
