# https://github.com/BerriAI/litellm/blob/main/helm/litellm-helm/values.yaml

{{- $maxInputTokens := 500000 }}
{{- $maxOutputTokens := 131072 }}

db:
  useExisting: true
  deployStandalone: false
  endpoint: "{{ .Values.release_name }}-data-postgresql"
  database: "{{ .StateValues.postgres_extra_databases.litellm }}"
  secret:
    name: postgresql-admin-credentials
    usernameKey: user
    passwordKey: password

# The proxy's provider keys, master key and salt come from an ExternalSecret in
# datahub-local-secrets. Clients authenticate with the same master key, delivered
# to them separately as litellm-auth-credentials.
masterkeySecretName: litellm-provider-credentials
masterkeySecretKey: LITELLM_MASTER_KEY

environmentSecrets:
  - litellm-provider-credentials

# Password for the coordination Redis wired up in proxy_config below.
extraEnvVars:
  - name: REDIS_PASSWORD
    valueFrom:
      secretKeyRef:
        name: valkey-admin-credentials
        key: password

# Admin UI SSO against Dex. The "litellm" client must be registered in Dex with
# this callback: https://data-litellm.<gateway_hostname>/sso/callback
envVars:
  PROXY_BASE_URL: "https://data-litellm.{{ .StateValues.gateway_hostname }}"
  GENERIC_CLIENT_ID: "litellm"
  GENERIC_CLIENT_SECRET: "{{ .StateValues.security_github_client_secret }}"
  GENERIC_AUTHORIZATION_ENDPOINT: "https://security-dex.{{ .StateValues.gateway_hostname }}/dex/auth"
  GENERIC_TOKEN_ENDPOINT: "https://security-dex.{{ .StateValues.gateway_hostname }}/dex/token"
  GENERIC_USERINFO_ENDPOINT: "https://security-dex.{{ .StateValues.gateway_hostname }}/dex/userinfo"
  GENERIC_SCOPE: "openid profile email groups"
  GENERIC_USER_ID_ATTRIBUTE: "sub"
  # The UI still ships a username/password form; this makes /ui jump straight
  # into the Dex flow so that form is never reachable.
  AUTO_REDIRECT_UI_LOGIN_TO_SSO: "true"

proxy_config:
  model_list:
    # --- Ollama (local, via the ollama-proxy sidecar the Service targets) ---
    - model_name: ollama/qwen3.5:4b
      litellm_params:
        model: ollama/qwen3.5:4b
        api_base: http://{{ .Values.release_name }}-data-ollama:11434

    # --- OpenCode Go ---
    # OpenAI-compatible but not a LiteLLM native provider, so each model goes
    # through the openai/ prefix with an explicit api_base. Ids are the ones in
    # https://opencode.ai/zen/go/v1/models.
    # Go rejects requests without an x-opencode-session header (400
    # MissingSessionID); clients pointed at the proxy do not send one and LiteLLM
    # strips client headers, so inject a fixed id here.
    # These are custom aliases, so LiteLLM has no cost-map entry and /model/info
    # reports a null token limit - clients then fall back to their own default
    # (OpenCode uses 200000/32000) instead of the model's real window. Pin the
    # limits on every entry so the window travels with the alias.
    # /model/info reports no capability flags either, and the OpenCode LiteLLM
    # plugin classifies a model without supports_vision as text-only, so the
    # client refuses to attach an image ("this model has no image input") even
    # though the provider takes one. Verified 2026-10-16 with a three-stripe
    # PNG: every flagged entry below names the stripes correctly, both direct
    # and through this proxy. glm-5.3 is the exception and stays unflagged - it
    # answers 400 "This model does not support image inputs".
    # Clients also grew a Responses API path (POST /v1/responses here), and the
    # openai/ handler forwards that verbatim to {api_base}/responses - where Go
    # serves deepseek-v4.1-flash and nothing else. Probed 2026-10-18 against the
    # gateway with the real key: glm-5.3, glm-5.3-flash, kimi-k3, qwen3.8-flash
    # and qwen3.8-max all answer that endpoint 400 ModelProtocolUnsupported
    # ("Model does not support this protocol"), while the same ids on
    # /chat/completions answer 200. So every Go entry except deepseek-v4.1-flash
    # carries use_chat_completions_api, which makes LiteLLM translate a Responses
    # request into a chat one instead of 400ing the caller's fallback hop.
    - model_name: opencode-go/glm-5.3-flash
      litellm_params:
        model: openai/glm-5.3-flash
        api_base: https://opencode.ai/zen/go/v1
        api_key: os.environ/OPENCODE_GO_API_KEY
        extra_headers:
          x-opencode-session: ses_datahub-local-litellm
        # This model always thinks and rejects reasoning_effort=none ([1210] "This model
        # always engages in thinking and cannot be disabled"), which is exactly what the
        # Pi composer sends, so as a fallback it could never serve the caller the chain
        # exists for. Probed 2026-10-16: with that parameter the unit answers 400 and the
        # router falls through to OpenRouter, in both the streaming and non-streaming
        # shape. Dropped for this hop only - the primary honours it, which is how the
        # gateway's reasoning is kept off the bill. [UNVERIFIED] whether the drop makes
        # this hop succeed.
        additional_drop_params:
          - reasoning_effort
        use_chat_completions_api: true
      model_info:
        max_input_tokens: {{ $maxInputTokens }}
        max_output_tokens: {{ $maxOutputTokens }}
        supports_vision: true
    - model_name: opencode-go/glm-5.3
      litellm_params:
        model: openai/glm-5.3
        api_base: https://opencode.ai/zen/go/v1
        api_key: os.environ/OPENCODE_GO_API_KEY
        extra_headers:
          x-opencode-session: ses_datahub-local-litellm
        use_chat_completions_api: true
      model_info:
        max_input_tokens: {{ $maxInputTokens }}
        max_output_tokens: {{ $maxOutputTokens }}
    - model_name: opencode-go/kimi-k3
      litellm_params:
        model: openai/kimi-k3
        api_base: https://opencode.ai/zen/go/v1
        api_key: os.environ/OPENCODE_GO_API_KEY
        extra_headers:
          x-opencode-session: ses_datahub-local-litellm
        use_chat_completions_api: true
      model_info:
        max_input_tokens: {{ $maxInputTokens }}
        max_output_tokens: {{ $maxOutputTokens }}
        supports_vision: true
    - model_name: opencode-go/deepseek-v4.1-flash
      litellm_params:
        model: openai/deepseek-v4.1-flash
        api_base: https://opencode.ai/zen/go/v1
        api_key: os.environ/OPENCODE_GO_API_KEY
        extra_headers:
          x-opencode-session: ses_datahub-local-litellm
      model_info:
        max_input_tokens: {{ $maxInputTokens }}
        max_output_tokens: {{ $maxOutputTokens }}
        supports_vision: true
    - model_name: opencode-go/qwen3.8-flash
      litellm_params:
        model: openai/qwen3.8-flash
        api_base: https://opencode.ai/zen/go/v1
        api_key: os.environ/OPENCODE_GO_API_KEY
        extra_headers:
          x-opencode-session: ses_datahub-local-litellm
        use_chat_completions_api: true
      model_info:
        max_input_tokens: {{ $maxInputTokens }}
        max_output_tokens: {{ $maxOutputTokens }}
        supports_vision: true
    - model_name: opencode-go/qwen3.8-max
      litellm_params:
        model: openai/qwen3.8-max
        api_base: https://opencode.ai/zen/go/v1
        api_key: os.environ/OPENCODE_GO_API_KEY
        extra_headers:
          x-opencode-session: ses_datahub-local-litellm
        use_chat_completions_api: true
      model_info:
        max_input_tokens: {{ $maxInputTokens }}
        max_output_tokens: {{ $maxOutputTokens }}
        supports_vision: true

    # --- OpenRouter (chat) ---
    # Same model as the opencode-go entry, second source. Reasoning model: a
    # small max_tokens is spent on reasoning and comes back with empty content.
    - model_name: openrouter/deepseek/deepseek-v4.1-flash
      litellm_params:
        model: openrouter/deepseek/deepseek-v4.1-flash
        api_key: os.environ/OPENROUTER_API_KEY
      model_info:
        max_input_tokens: {{ $maxInputTokens }}
        max_output_tokens: {{ $maxOutputTokens }}
        supports_vision: true

    # --- OpenRouter (image generation) ---
    # All but gemini-3.1-flash-image are absent from /chat/completions, which is
    # the only route LiteLLM's openrouter/ image handler posts to. OpenRouter's
    # unified Image API also answers on /images/generations with an OpenAI-shaped
    # body, so reach all four through the openai/ handler and an explicit
    # api_base. Call them on /v1/images/generations, not /v1/chat/completions.
    - model_name: openrouter/openai/gpt-image-2.5-sunburst
      litellm_params:
        model: openai/openai/gpt-image-2.5-sunburst
        api_base: https://openrouter.ai/api/v1
        api_key: os.environ/OPENROUTER_API_KEY
      model_info:
        mode: image_generation
    - model_name: openrouter/google/gemini-3.1-flash-image
      litellm_params:
        model: openai/google/gemini-3.1-flash-image
        api_base: https://openrouter.ai/api/v1
        api_key: os.environ/OPENROUTER_API_KEY
      model_info:
        mode: image_generation
    - model_name: openrouter/qwen/qwen-image-3-pro
      litellm_params:
        model: openai/qwen/qwen-image-3-pro
        api_base: https://openrouter.ai/api/v1
        api_key: os.environ/OPENROUTER_API_KEY
      model_info:
        mode: image_generation
    - model_name: openrouter/bytedance-seed/seedream-5-0-pro
      litellm_params:
        model: openai/bytedance-seed/seedream-5-0-pro
        api_base: https://openrouter.ai/api/v1
        api_key: os.environ/OPENROUTER_API_KEY
      model_info:
        mode: image_generation

  general_settings:
    master_key: os.environ/PROXY_MASTER_KEY
    # Shares rate limits, budgets and router state across workers; dbs 0-1 are taken.
    coordination_redis:
      host: "{{ .Values.release_name }}-data-valkey-headless"
      port: 6379
      db: 2
      password: os.environ/REDIS_PASSWORD
    # drop_params strips OpenRouter's non-OpenAI image params (resolution,
    # aspect_ratio, output_format, provider.options). Expose the Image API
    # verbatim for callers that need them.
    pass_through_endpoints:
      - path: "/openrouter/images"
        target: "https://openrouter.ai/api/v1/images"
        headers:
          Authorization: "Bearer os.environ/OPENROUTER_API_KEY"
          content-type: application/json
  litellm_settings:
    # Providers reject kwargs they do not know; let LiteLLM drop them instead.
    drop_params: true
    # Mounts /metrics. Without a callback the proxy never mounts it, so a scrape
    # falls through to the auth middleware and 401s. The mounted app is public.
    success_callback: ["prometheus"]
    # OpenCode Go hangs rather than refusing when a model is unhealthy, and this
    # setting defaults to 600s - so a dead primary parked every caller for ten
    # minutes before the chain below was even tried, and an n8n model node
    # retries five times on top of that: one LinkedIn Image Creator run spent 51
    # minutes failing that way (execution 10751, 2026-09-14). 30s is far past a
    # healthy completion here - glm answers in ~1s, ollama in ~6s - so it only
    # ever fires on a hang, and turns an outage into a fallback.
    request_timeout: 30
    # The fleet's primary model is deepseek-v4.1-flash; when it errors at the
    # provider (rate limit, outage, bad gateway) the router retries against
    # glm-5.3-flash instead of failing the run. That hop costs nothing extra -
    # same OpenCode Go subscription - but it is also the same host, key and
    # x-opencode-session, so a provider-level failure takes both out at once:
    # on 2026-09-14 deepseek hung and glm answered InternalServerError in the
    # same run. The last hop is therefore OpenRouter, an independent path to the
    # same model, and the only one of the three that is paid per token.
    fallbacks:
      - opencode-go/deepseek-v4.1-flash:
          - opencode-go/glm-5.3-flash
          - openrouter/deepseek/deepseek-v4.1-flash
      - opencode-go/glm-5.3-flash:
          - openrouter/deepseek/deepseek-v4.1-flash
    # New SSO users default to proxy_admin; without this LiteLLM falls back to
    # internal_user_viewer.
    default_internal_user_params:
      user_role: proxy_admin

  # `request_timeout` above is a per-read timeout, and for a streaming call that means
  # the gap between chunks - so it is the only timeout a stream ever gets. A streaming
  # caller is not rescued by the fallback chain below: stream_with_fallbacks re-raises
  # the provider's own error once any content has reached the client, so a primary that
  # emits a sentence and then stalls ends that call outright, with no substitution.
  # Patience is the recovery mechanism for a stream, so a stream gets its own longer
  # read timeout and the caller retries; the 30s stays for everything that does not
  # stream, where the fallback chain does fire. Measured 2026-10-16: a 30s stall killed
  # nine consecutive composer attempts, no composition was authored, the artifact fetch
  # answered 404, and one article lost its animation (Visual Studio run 13648).
  router_settings:
    stream_timeout: 120

resources:
  requests:
    cpu: 200m
    memory: 1Gi
  limits:
    # The litellm-database image bundles prisma and spikes well past 1Gi while
    # loading the router; the chart itself recommends 4Gi.
    memory: 4Gi

# /metrics/ requires a bearer token; the chart's ServiceMonitor scrapes it
# unauthenticated, so it is patched with bearerTokenSecret in
# values/_kustomize.yaml.gotmpl.
serviceMonitor:
  enabled: true
