# https://github.com/BerriAI/litellm/blob/main/helm/litellm-helm/values.yaml

db:
  useExisting: true
  deployStandalone: false
  endpoint: "{{ .Values.release_name }}-data-postgresql"
  database: "{{ .StateValues.postgres_extra_databases.litellm }}"
  secret:
    name: postgresql-admin-credentials
    usernameKey: user
    passwordKey: password

# The proxy's provider keys, master key and salt come from an ExternalSecret in
# datahub-local-secrets. Clients authenticate with the same master key, delivered
# to them separately as litellm-auth-credentials.
masterkeySecretName: litellm-provider-credentials
masterkeySecretKey: LITELLM_MASTER_KEY

environmentSecrets:
  - litellm-provider-credentials

# Admin UI SSO against Dex. The "litellm" client must be registered in Dex with
# this callback: https://data-litellm.<gateway_hostname>/sso/callback
envVars:
  PROXY_BASE_URL: "https://data-litellm.{{ .StateValues.gateway_hostname }}"
  GENERIC_CLIENT_ID: "litellm"
  GENERIC_CLIENT_SECRET: "{{ .StateValues.security_github_client_secret }}"
  GENERIC_AUTHORIZATION_ENDPOINT: "https://security-dex.{{ .StateValues.gateway_hostname }}/dex/auth"
  GENERIC_TOKEN_ENDPOINT: "https://security-dex.{{ .StateValues.gateway_hostname }}/dex/token"
  GENERIC_USERINFO_ENDPOINT: "https://security-dex.{{ .StateValues.gateway_hostname }}/dex/userinfo"
  GENERIC_SCOPE: "openid profile email groups"
  GENERIC_USER_ID_ATTRIBUTE: "sub"
  # The UI still ships a username/password form; this makes /ui jump straight
  # into the Dex flow so that form is never reachable.
  AUTO_REDIRECT_UI_LOGIN_TO_SSO: "true"

proxy_config:
  model_list:
    # --- Ollama (local, via the ollama-proxy sidecar the Service targets) ---
    - model_name: ollama/qwen3.5:4b
      litellm_params:
        model: ollama/qwen3.5:4b
        api_base: http://{{ .Values.release_name }}-data-ollama:11434

    # --- OpenCode Go ---
    # OpenAI-compatible but not a LiteLLM native provider, so each model goes
    # through the openai/ prefix with an explicit api_base. Ids are the ones in
    # https://opencode.ai/zen/go/v1/models.
    # Go rejects requests without an x-opencode-session header (400
    # MissingSessionID); clients pointed at the proxy do not send one and LiteLLM
    # strips client headers, so inject a fixed id here.
    - model_name: opencode-go/glm-5.3-flash
      litellm_params:
        model: openai/glm-5.3-flash
        api_base: https://opencode.ai/zen/go/v1
        api_key: os.environ/OPENCODE_GO_API_KEY
        extra_headers:
          x-opencode-session: ses_datahub-local-litellm
    - model_name: opencode-go/glm-5.3
      litellm_params:
        model: openai/glm-5.3
        api_base: https://opencode.ai/zen/go/v1
        api_key: os.environ/OPENCODE_GO_API_KEY
        extra_headers:
          x-opencode-session: ses_datahub-local-litellm
    - model_name: opencode-go/kimi-k3
      litellm_params:
        model: openai/kimi-k3
        api_base: https://opencode.ai/zen/go/v1
        api_key: os.environ/OPENCODE_GO_API_KEY
        extra_headers:
          x-opencode-session: ses_datahub-local-litellm
    - model_name: opencode-go/deepseek-v4.1-flash
      litellm_params:
        model: openai/deepseek-v4.1-flash
        api_base: https://opencode.ai/zen/go/v1
        api_key: os.environ/OPENCODE_GO_API_KEY
        extra_headers:
          x-opencode-session: ses_datahub-local-litellm
    - model_name: opencode-go/qwen3.8-flash
      litellm_params:
        model: openai/qwen3.8-flash
        api_base: https://opencode.ai/zen/go/v1
        api_key: os.environ/OPENCODE_GO_API_KEY
        extra_headers:
          x-opencode-session: ses_datahub-local-litellm
    - model_name: opencode-go/qwen3.8-max
      litellm_params:
        model: openai/qwen3.8-max
        api_base: https://opencode.ai/zen/go/v1
        api_key: os.environ/OPENCODE_GO_API_KEY
        extra_headers:
          x-opencode-session: ses_datahub-local-litellm

    # --- OpenRouter ---
    # Image-generation models; call them through /v1/images/generations.
    - model_name: openrouter/openai/gpt-image-2.5-sunburst
      litellm_params:
        model: openrouter/openai/gpt-image-2.5-sunburst
        api_key: os.environ/OPENROUTER_API_KEY
    - model_name: openrouter/google/gemini-3.1-flash-image
      litellm_params:
        model: openrouter/google/gemini-3.1-flash-image
        api_key: os.environ/OPENROUTER_API_KEY
    - model_name: openrouter/qwen/qwen-image-3-pro
      litellm_params:
        model: openrouter/qwen/qwen-image-3-pro
        api_key: os.environ/OPENROUTER_API_KEY
    - model_name: openrouter/bytedance-seed/seedream-5-0-pro
      litellm_params:
        model: openrouter/bytedance-seed/seedream-5-0-pro
        api_key: os.environ/OPENROUTER_API_KEY

  general_settings:
    master_key: os.environ/PROXY_MASTER_KEY
  litellm_settings:
    # Providers reject kwargs they do not know; let LiteLLM drop them instead.
    drop_params: true
    # Mounts /metrics. Without a callback the proxy never mounts it, so a scrape
    # falls through to the auth middleware and 401s. The mounted app is public.
    success_callback: ["prometheus"]
    # New SSO users default to proxy_admin; without this LiteLLM falls back to
    # internal_user_viewer.
    default_internal_user_params:
      user_role: proxy_admin

resources:
  requests:
    cpu: 200m
    memory: 1Gi
  limits:
    # The litellm-database image bundles prisma and spikes well past 1Gi while
    # loading the router; the chart itself recommends 4Gi.
    memory: 4Gi

# /metrics/ requires a bearer token; the chart's ServiceMonitor scrapes it
# unauthenticated, so it is patched with bearerTokenSecret in
# values/_kustomize.yaml.gotmpl.
serviceMonitor:
  enabled: true
