# https://github.com/otwld/ollama-helm/blob/main/values.yaml
ollama:
  gpu:
    enabled: true
    type: "nvidia"
    number: 1
  models:
    pull:
      - gemma4:e2b-it-qat

# -- Default context window (Ollama defaults to 4096, which truncates longer
# Open WebUI conversations with an "exceeds context size" error). 131072 is
# gemma4's full trained window; as the only resident model on the RTX 3060
# Laptop GPU (6 GiB) it measures 3.6 GiB with every layer on the GPU.
extraEnv:
  - name: OLLAMA_CONTEXT_LENGTH
    value: "131072"

updateStrategy:
  type: Recreate

runtimeClassName: nvidia

hostNetwork: true

persistentVolume:
  enabled: true
  storageClass: local-path

tolerations:
  - key: nvidia.com/gpu
    operator: Exists
    effect: NoSchedule

extraObjects:
  - apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      annotations:
        gethomepage.dev/enabled: "true"
        gethomepage.dev/name: "Ollama"
        gethomepage.dev/pod-selector: "app.kubernetes.io/name=ollama"
        gethomepage.dev/group: "Data"
        gethomepage.dev/icon: "sh-ollama"
        gethomepage.dev/href: "https://data-ollama.{{ .StateValues.gateway_hostname }}"
      name: "{{ $.Values.release_name }}-data-ollama"
    spec:
      entryPoints:
        - websecure
      routes:
        - match: Host(`data-ollama.{{ .StateValues.gateway_hostname }}`)
          kind: Rule
          services:
            - name: "{{ $.Values.release_name }}-data-ollama"
              port: http
          middlewares:
            - name: oauth2-proxy-auth
              namespace: security
        - match: Host(`data-ollama.{{ .StateValues.gateway_hostname }}`) && PathPrefix(`/oauth2/`)
          kind: Rule
          services:
            - name: oauth2-proxy
              namespace: security
              port: http
