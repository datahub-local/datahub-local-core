# https://github.com/otwld/ollama-helm/blob/main/values.yaml
ollama:
  gpu:
    enabled: true
    type: "nvidia"
    number: 1
  models:
    pull:
      - qwen3.5:4b

# -- Default context window; Ollama's own default of 4096 truncates longer
# Open WebUI conversations with an "exceeds context size" error.
extraEnv:
  - name: OLLAMA_CONTEXT_LENGTH
    value: "32768"

# The metrics-proxy sidecar patch lands ahead of ollama in the container list.
podAnnotations:
  kubectl.kubernetes.io/default-container: ollama

updateStrategy:
  type: Recreate

runtimeClassName: nvidia

hostNetwork: true

persistentVolume:
  enabled: true
  storageClass: local-path

tolerations:
  - key: nvidia.com/gpu
    operator: Exists
    effect: NoSchedule

extraObjects:
  # Scrapes the metrics-proxy sidecar patched in by ../values/_kustomize.yaml.gotmpl.
  - apiVersion: monitoring.coreos.com/v1
    kind: ServiceMonitor
    metadata:
      name: "{{ $.Values.release_name }}-data-ollama"
    spec:
      selector:
        matchLabels:
          app.kubernetes.io/name: ollama
          app.kubernetes.io/instance: "{{ $.Values.release_name }}-data-ollama"
      endpoints:
        - port: http
          path: /metrics
          interval: 30s
  - apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      annotations:
        gethomepage.dev/enabled: "true"
        gethomepage.dev/name: "Ollama"
        gethomepage.dev/pod-selector: "app.kubernetes.io/name=ollama"
        gethomepage.dev/group: "Data"
        gethomepage.dev/icon: "sh-ollama"
        gethomepage.dev/href: "https://data-ollama.{{ .StateValues.gateway_hostname }}"
      name: "{{ $.Values.release_name }}-data-ollama"
    spec:
      entryPoints:
        - websecure
      routes:
        - match: Host(`data-ollama.{{ .StateValues.gateway_hostname }}`)
          kind: Rule
          services:
            - name: "{{ $.Values.release_name }}-data-ollama"
              port: http
          middlewares:
            - name: oauth2-proxy-auth
              namespace: security
        - match: Host(`data-ollama.{{ .StateValues.gateway_hostname }}`) && PathPrefix(`/oauth2/`)
          kind: Rule
          services:
            - name: oauth2-proxy
              namespace: security
              port: http
