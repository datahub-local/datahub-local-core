
#{{ $gateway_hostname := "homelab.alvsanand.com" }}

prometheus_rules:
  datahub.local.rules:
    - name: datahub.local.rules
      rules:
        - alert: HighCPUTemperature
          annotations:
            description: '{{`{{ printf "%.4g" $value }}`}} °C detected in {{`{{ $labels.instance }}`}}. This is a high temperature and you must shutdown the server'
            summary: One or more nodes have a high CPUs temperature'
          expr: avg(avg_over_time(node_hwmon_temp_celsius[1m])) by (instance) > 65
          for: 5m
          labels:
            severity: high
        - alert: ExtremeCPUTemperature
          annotations:
            description: '{{`{{ printf "%.4g" $value }}`}} °C detected in {{`{{ $labels.instance }}`}}. This is a high temperature and you must shutdown the server'
            summary: One or more nodes have a extreme CPUs temperature'
          expr: avg(avg_over_time(node_hwmon_temp_celsius[1m])) by (instance) > 75
          for: 5m
          labels:
            severity: critical
        - alert: HighHDDTemperature
          annotations:
            description: '{{`{{ printf "%.4g" $value }}`}} °C detected in {{`{{ $labels.instance }}`}}. This is a high temperature in your HDD and you must shutdown the server'
            summary: One or more nodes have a high HDDs temperature'
          expr: avg(avg_over_time(smartmon_temperature_celcius[1m])) by (instance) > 70
          for: 5m
          labels:
            severity: warning
        - alert: ExtremeHDDTemperature
          annotations:
            description: '{{`{{ printf "%.4g" $value }}`}} °C detected in {{`{{ $labels.instance }}`}}. This is a high temperature in your HDD and you must shutdown the server'
            summary: One or more nodes have a extreme HDDs temperature'
          expr: avg(avg_over_time(smartmon_temperature_celcius[1m])) by (instance) > 95
          for: 5m
          labels:
            severity: critical
        - alert: ArgoAppMissing
          expr: |
            absent(argocd_app_info) == 1
          for: 15m
          labels:
            severity: critical
          annotations:
            summary: "[Argo CD] No reported applications"
            description: >
              Argo CD has not reported any applications data for the past 15 minutes which
              means that it must be down or not functioning properly.  This needs to be
              resolved for this cloud to continue to maintain state.
        - alert: ArgoAppNotSynced
          expr: |
            argocd_app_info{sync_status!="Synced"} == 1
          for: 12h
          labels:
            severity: warning
          annotations:
            summary: "[{{`{{$labels.name}}`}}] Application not synchronized"
            description: >
              The application [{{`{{$labels.name}}`}} has not been synchronized for over
              12 hours which means that the state of this cloud has drifted away from the
              state inside Git.
        - alert: PVCUsageHigh
          annotations:
            description: 'The PVC {{`{{ $labels.persistentvolumeclaim }}`}} in namespace {{`{{ $labels.namespace }}`}} is {{`{{ printf "%.2f" $value }}`}}% full.'
            summary: PVC is running out of space (> 75%)
          expr: 100 * kubelet_volume_stats_used_bytes / kubelet_volume_stats_capacity_bytes > 75
          for: 5m
          labels:
            severity: warning
        - alert: PVCUsageCritical
          annotations:
            description: 'The PVC {{`{{ $labels.persistentvolumeclaim }}`}} in namespace {{`{{ $labels.namespace }}`}} is {{`{{ printf "%.2f" $value }}`}}% full.'
            summary: PVC is running out of space (> 90%)
          expr: 100 * kubelet_volume_stats_used_bytes / kubelet_volume_stats_capacity_bytes > 90
          for: 5m
          labels:
            severity: critical
        - alert: PVCUsageFull
          annotations:
            description: 'The PVC {{`{{ $labels.persistentvolumeclaim }}`}} in namespace {{`{{ $labels.namespace }}`}} is {{`{{ printf "%.2f" $value }}`}}% full.'
            summary: PVC is full (> 99%)
          expr: 100 * kubelet_volume_stats_used_bytes / kubelet_volume_stats_capacity_bytes > 99
          for: 1m
          labels:
            severity: critical
        - alert: SpeedtestDownloadSpeedLowWarning
          expr: |
            (speedtest_download_bits_per_second < 0.2 * avg_over_time(speedtest_download_bits_per_second[24h]))
          for: 5m
          labels:
            severity: warning
          annotations:
            summary: "Download speed dropped below 20% of 24h average"
            description: "Current download speed is {{`{{ printf \"%.2f\" $value }}`}} bps, which is less than 20% of the average over the last 24h."

        - alert: SpeedtestDownloadSpeedLowCritical
          expr: |
            (speedtest_download_bits_per_second < 0.05 * avg_over_time(speedtest_download_bits_per_second[24h]))
          for: 5m
          labels:
            severity: critical
          annotations:
            summary: "Download speed dropped below 5% of 24h average"
            description: "Current download speed is {{`{{ printf \"%.2f\" $value }}`}} bps, which is less than 5% of the average over the last 24h."

        - alert: SpeedtestUploadSpeedLowWarning
          expr: |
            (speedtest_upload_bits_per_second < 0.2 * avg_over_time(speedtest_upload_bits_per_second[24h]))
          for: 5m
          labels:
            severity: warning
          annotations:
            summary: "Upload speed dropped below 20% of 24h average"
            description: "Current upload speed is {{`{{ printf \"%.2f\" $value }}`}} bps, which is less than 20% of the average over the last 24h."

        - alert: SpeedtestUploadSpeedLowCritical
          expr: |
            (speedtest_upload_bits_per_second < 0.05 * avg_over_time(speedtest_upload_bits_per_second[24h]))
          for: 5m
          labels:
            severity: critical
          annotations:
            summary: "Upload speed dropped below 5% of 24h average"
            description: "Current upload speed is {{`{{ printf \"%.2f\" $value }}`}} bps, which is less than 5% of the average over the last 24h."
  n8n.rules:
    - name: n8n.rules
      rules:
        # The second clause is load-bearing: a histogram series does not exist
        # until its first observation, so a counter whose first sample is 1 has
        # no 0->1 step and increase() reads it as 0 forever. Verified against a
        # real recorded failure. The clause fires while the series is younger
        # than the window, which is the only way a first-ever failure is seen.
        # workflow_name is joined in from n8n_workflow_info; the histogram itself
        # carries only status, mode and workflow_id. The or-fallback keeps a
        # workflow with no info entry alerting on id rather than dropping it.
        - alert: N8nWorkflowExecutionFailed
          expr: |
            (
              (
                (
                  sum by (workflow_id, mode) (
                    increase(n8n_workflow_execution_duration_seconds_count{status="failed"}[1h])
                  ) > 0
                )
                or
                (
                  sum by (workflow_id, mode) (n8n_workflow_execution_duration_seconds_count{status="failed"})
                  unless
                  sum by (workflow_id, mode) (n8n_workflow_execution_duration_seconds_count{status="failed"} offset 1h)
                )
              )
              * on (workflow_id) group_left(workflow_name) n8n_workflow_info
            )
            or
            (
              (
                sum by (workflow_id, mode) (
                  increase(n8n_workflow_execution_duration_seconds_count{status="failed"}[1h])
                ) > 0
              )
              or
              (
                sum by (workflow_id, mode) (n8n_workflow_execution_duration_seconds_count{status="failed"})
                unless
                sum by (workflow_id, mode) (n8n_workflow_execution_duration_seconds_count{status="failed"} offset 1h)
              )
            )
          for: 0m
          labels:
            severity: warning
            namespace: automation
          annotations:
            summary: "n8n workflow failed: {{`{{ if $labels.workflow_name }}{{ $labels.workflow_name }}{{ else }}{{ $labels.workflow_id }}{{ end }}`}}"
            description: "Workflow {{`{{ if $labels.workflow_name }}{{ $labels.workflow_name }}{{ else }}(name unknown){{ end }}`}} ({{`{{ $labels.workflow_id }}`}}) recorded a failed execution (mode {{`{{ $labels.mode }}`}}). Executions: https://automation-n8n.{{ $gateway_hostname }}/workflow/{{`{{ $labels.workflow_id }}`}}/executions?status=error - open the most recent one for the message and failing node."

        - alert: N8nInstanceDown
          expr: |
            up{job=~"automation/.*-automation-n8n.*"} == 0
          for: 5m
          labels:
            severity: critical
            namespace: automation
          annotations:
            summary: "n8n instance is not being scraped"
            description: "Prometheus cannot scrape {{`{{ $labels.pod }}`}} (job {{`{{ $labels.job }}`}}). An n8n error workflow cannot fire while its own instance is down, so this alert is the only notification path for that case."

        - alert: N8nNoInstanceScraped
          expr: |
            absent(n8n_process_open_fds)
          for: 10m
          labels:
            severity: critical
            namespace: automation
          annotations:
            summary: "no n8n instance is reporting metrics"
            description: "Every n8n metric series has disappeared. Either all pods are down, or the PodMonitor selectors in releases/automation/values/n8n.yaml.gotmpl no longer match any pod."

        - alert: N8nQueueBacklog
          expr: |
            max(n8n_scaling_mode_queue_jobs_waiting) > 0
          for: 15m
          labels:
            severity: warning
            namespace: automation
          annotations:
            summary: "n8n execution queue is not draining"
            description: "{{`{{ printf \"%.0f\" $value }}`}} job(s) have been waiting in the queue for 15m. Check the worker pod is running and connected to Valkey."

        - alert: N8nNoActiveWorkflows
          expr: |
            max(n8n_active_workflow_count) == 0
          for: 15m
          labels:
            severity: critical
            namespace: automation
          annotations:
            summary: "n8n has no active workflows"
            description: "Every workflow trigger has been deactivated or failed to register. No schedule, webhook or form trigger will fire."
  sympozium.rules:
    - name: sympozium.rules
      rules:
        # Why the cause is classified once, here, rather than in each alert: the
        # regex would otherwise be pasted into every rule that needs it and drift
        # from the others. label_replace leaves a series it does not match
        # untouched, so an unclassified failure is cause="".
        #
        # (?is) is load-bearing on both counts. A Prometheus regex is anchored, so
        # the leading and trailing .* are required; and `.` does not cross a
        # newline in RE2, which a multi-line provider error contains.
        - record: sympozium_agentrun:error_cause
          expr: |
            label_replace(
              sympozium_agentrun_error_info,
              "cause", "rate_limited", "error",
              "(?is).*(429|rate.?limit|usage limit|too many requests|quota).*"
            )

        # A failed AgentRun notifies nobody on its own: nothing watches the CR,
        # and the run's own delivery hook posts to the persona's channel, not to
        # an operator's. kube-state-metrics exports the run's phase as a label on
        # sympozium_agentrun_info, so the Failed series appears the moment the
        # phase flips; the completedAt window limits the alert to the first hour
        # of that failure rather than leaving it firing until the run is pruned.
        # Delivered to #monitoring-ai-runs by the second sink in robusta.yaml.gotmpl.
        #
        # The window is measured off completedAt and not `unless X offset 1h`,
        # which asks "was this series here an hour ago" and so replays every
        # still-Failed run whenever the answer is no for a reason that is not the
        # run: kube-state-metrics losing the series for longer than the 5m
        # lookback, its pod label changing on a reschedule, or the metric being
        # introduced at all. That last one fired both 19:00 runs at 20:22 on
        # 2026-09-13, 79 minutes after they failed, when error_info first shipped.
        #
        # The rate-limited runs are carved out below, so this one is every other
        # failure and its cause still has to be read off the object.
        - alert: SympoziumAgentRunFailed
          expr: |
            (
              sympozium_agentrun_info{phase="Failed"} == 1
              and on (name, namespace)
              (time() - sympozium_agentrun_completed_timestamp_seconds) < 3600
            )
            unless on (name, namespace)
            sympozium_agentrun:error_cause{cause="rate_limited"}
          for: 0m
          labels:
            severity: error
            namespace: automation
          annotations:
            summary: "Sympozium run failed: {{`{{ $labels.agent }}`}} ({{`{{ $labels.ensemble }}`}})"
            description: "AgentRun {{`{{ $labels.name }}`}} in {{`{{ $labels.namespace }}`}} ended Failed (model {{`{{ $labels.model }}`}}, trigger {{`{{ $labels.trigger }}`}}). Read it with: kubectl -n {{`{{ $labels.namespace }}`}} get agentrun {{`{{ $labels.name }}`}} -o jsonpath='{.status.error}'"

        # Split out because the action is different and the alert can say so: the
        # run never reached the model, so there is nothing wrong with the agent,
        # the prompt or the cluster, and re-running before the window resets just
        # spends another attempt. Both evening reporters died this way at 19:00 on
        # 2026-09-13, and the gateway's fallback shares the account whose limit was
        # hit, so it cannot rescue the call.
        - alert: SympoziumAgentRunRateLimited
          expr: |
            sympozium_agentrun:error_cause{cause="rate_limited"} == 1
            and on (name, namespace)
            (time() - sympozium_agentrun_completed_timestamp_seconds) < 3600
          for: 0m
          labels:
            severity: error
            namespace: automation
          annotations:
            summary: "Sympozium run rate-limited: {{`{{ $labels.agent }}`}} ({{`{{ $labels.ensemble }}`}})"
            description: "AgentRun {{`{{ $labels.name }}`}} in {{`{{ $labels.namespace }}`}} never reached the model: the LLM gateway refused the call. {{`{{ $labels.error }}`}}"
  # Helm release history, and the Secret list Argo CD has to read. The chain, measured
  # 2026-10-16: Helm's default 10 revisions per release made ~140 release Secrets and a
  # ~30 MB cluster-wide Secret LIST; the kube-apiserver (2.8 GB RSS on a 4 GB
  # control-plane node) could not stream it, so Argo CD's controller logged "failed to
  # load initial state of resource Secret" and left every Application at sync=Unknown
  # for an hour - with no pod unhealthy and no other symptom. Prevented for the releases
  # this repo applies by helmDefaults.historyMax in values/base.yaml.gotmpl, and pruned
  # for the bootstrap-installed ones (traefik, cert-manager, argo-cd, longhorn) by
  # datahub-local-bootstrap's roles/k3s_maintenance, which nothing schedules yet - hence
  # the first alert below.
  gitops.rules:
    - name: gitops.rules
      rules:
        - alert: HelmReleaseHistorySecretsGrowing
          expr: |
            sum(kube_secret_info{secret=~"sh\\.helm\\.release\\.v1\\..*"}) > 30
          for: 30m
          labels:
            severity: warning
          annotations:
            summary: "Helm release history is accumulating in Secrets"
            description: >
              {{`{{ printf "%.0f" $value }}`}} Helm release-history Secrets exist, one per retained
              revision and each holding a whole rendered chart. They dominate a cluster-wide
              Secret LIST, which is what Argo CD reads to build its cluster cache, and that list
              is what breaks first. Run playbook/maintenance.yml from datahub-local-bootstrap to
              prune every release to k3s_maintenance_helm_history_keep revisions - and re-read
              that value: keeping three revisions of traefik, argo-cd and cert-manager was still
              ~10 MB here, where one revision per release is ~4 MB.
        - alert: ClusterSecretListResponseLarge
          expr: |
            (
              sum(increase(apiserver_response_sizes_sum{resource="secrets",verb="LIST",scope="cluster"}[30m]))
              /
              sum(increase(apiserver_response_sizes_count{resource="secrets",verb="LIST",scope="cluster"}[30m]))
            ) > 6e6
          for: 15m
          labels:
            severity: warning
          annotations:
            summary: "A cluster-wide Secret LIST response averages over 6 MB"
            description: >
              The average response to a cluster-scoped Secret LIST has been
              {{`{{ printf "%.0f" $value }}`}} bytes over the last hour. Argo CD reads that list to
              load its cluster cache, and at roughly 10 MB the kube-apiserver aborted the stream,
              leaving every Application at sync=Unknown. One revision per release measured
              ~3-4.5 MB, so this is the warning that the payload is climbing again: the cause is
              almost always retained Helm history, which the alert above names.
        - alert: ArgoAppSyncComparisonFailing
          expr: |
            argocd_app_info{sync_status="Unknown"} == 1
          for: 15m
          labels:
            severity: error
          annotations:
            summary: "[{{`{{ $labels.name }}`}}] Argo CD cannot compare the application"
            description: >
              Argo CD reports sync_status=Unknown for {{`{{ $labels.name }}`}} for 15m, which means
              it could not load the cluster state to compare against - not that the application
              drifted, and not that anything inside it is down. Several applications going Unknown
              together means the controller's cluster cache is failing on one resource kind,
              usually Secret. Read the reason with: kubectl -n automation logs
              statefulset/argo-cd-argocd-application-controller --tail=100 | grep 'Failed to sync
              cluster'
