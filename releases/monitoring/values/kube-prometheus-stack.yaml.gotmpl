# https://github.com/prometheus-community/helm-charts/blob/main/charts/kube-prometheus-stack/values.yaml

prometheusOperator:
  admissionWebhooks:
    enabled: false

  tls:
    enabled: false

prometheus:
  prometheusSpec:
    externalUrl: "https://monitoring-prometheus.{{ .StateValues.gateway_hostname }}:{{ .StateValues.ingress_port }}/"
    routePrefix: /

    podMonitorSelectorNilUsesHelmValues: false
    probeSelectorNilUsesHelmValues: false
    ruleSelectorNilUsesHelmValues: false
    scrapeConfigSelectorNilUsesHelmValues: false
    serviceMonitorSelectorNilUsesHelmValues: false

    replicas: 1
    retention: 30d
    # Whichever limit hits first; leaves headroom for the WAL and compaction.
    retentionSize: 24GB

    # StatefulSet volumeClaimTemplate: resizing later needs a manual PVC patch.
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: longhorn-no-replica
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: 30Gi

alertmanager:
  alertmanagerSpec:
    replicas: 2

  config: # Defined by Robusta (https://docs.robusta.dev/master/configuration/alertmanager-integration/alert-manager.html)
    receivers:
      - name: "default-receiver"
      - name: "robusta"
        webhook_configs:
          - url: "http://{{ $.Values.release_name }}-robusta-runner/api/alerts"
            send_resolved: true

    route:
      routes:
        - receiver: "robusta"
          group_by: ["..."]
          group_wait: 1s
          group_interval: 1s
          matchers:
            - severity =~ ".*"
          repeat_interval: 4h
          continue: true #
      receiver: "default-receiver"

# k3s embeds these (no separate metrics endpoint) and uses SQLite, not etcd.
kubeControllerManager:
  enabled: false

kubeScheduler:
  enabled: false

kubeProxy:
  enabled: false

kubeEtcd:
  enabled: false

defaultRules:
  rules:
    kubeProxy: false
    kubeControllerManager: false
    kubeSchedulerAlerting: false
    kubeSchedulerRecording: false

  node:
    fsSelector: 'fstype=~"ext[234]|btrfs|xfs|zfs"'

grafana:
  assertNoLeakedSecrets: false
  deploymentStrategy:
    type: Recreate

  # Read-only Postgres identity for the n8n execution list on the automation-n8n
  # dashboard. Grafana expands $VAR in provisioning files, so the datasource in
  # ../templates/grafana_datasource.yaml carries the reference, not the value.
  envValueFrom:
    POSTGRES_VIEWER_USER:
      secretKeyRef:
        name: postgresql-viewer-credentials
        key: username
    POSTGRES_VIEWER_PASSWORD:
      secretKeyRef:
        name: postgresql-viewer-credentials
        key: password
  persistence:
    enabled: true
    storageClass: longhorn
    size: 2Gi
  grafana.ini:
    plugins:
      # Grafana 13 ships the SQL datasources as bundled plugins and updates them at
      # startup. readOnlyRootFilesystem makes that write fail after the installer has
      # already stopped the plugin, leaving postgres and mssql unregistered - the n8n
      # datasource then loads as "Plugin not registered".
      preinstall_disabled: true
    server:
      domain: "monitoring-grafana.{{ .StateValues.gateway_hostname }}"
      root_url: "https://monitoring-grafana.{{ .StateValues.gateway_hostname }}:{{ .StateValues.ingress_port }}"
      serve_from_sub_path: true
    auth:
      disable_login_form: true
      disable_signout_menu: true
    auth.basic:
      enabled: true
    #{{- if .Values.security_enabled }}
    auth.generic_oauth:
      enabled: true
      allow_sign_up: true
      auto_login: true

      client_id: "grafana"
      client_secret: "{{ .StateValues.security_github_client_secret }}"
      scopes: "openid email profile groups offline_access"
      auth_url: "https://security-dex.{{ .StateValues.gateway_hostname }}/dex/auth"
      token_url: "https://security-dex.{{ .StateValues.gateway_hostname }}/dex/token"
      api_url: "https://security-dex.{{ .StateValues.gateway_hostname }}/dex/userinfo"
    users:
      auto_assign_org_role: Admin
    #{{- else }}
    auth.anonymous:
      enabled: true
      org_role: Admin
    #{{- end }}
  admin:
    existingSecret: "grafana-admin-credentials"
    userKey: user
    passwordKey: password

# Sympozium keeps every run's outcome in AgentRun CRs and exports nothing to
# Prometheus itself, so kube-state-metrics reads the CRs instead.
kube-state-metrics:
  rbac:
    extraRules:
      - apiGroups: ["sympozium.ai"]
        resources: ["agentruns"]
        verbs: ["list", "watch"]

  customResourceState:
    enabled: true
    config:
      spec:
        resources:
          - groupVersionKind:
              group: sympozium.ai
              version: v1alpha1
              kind: AgentRun
            metricNamePrefix: sympozium_agentrun
            labelsFromPath:
              name: [metadata, name]
              namespace: [metadata, namespace]
              agent: [metadata, labels, "sympozium.ai/instance"]
              ensemble: [metadata, labels, "sympozium.ai/ensemble"]
              trigger: [metadata, labels, "sympozium.ai/type"]
            metrics:
              # phase rides here rather than in a StateSet: the CRD does not
              # constrain it, so a hardcoded state list would silently drop
              # every run whose phase upstream later adds.
              - name: info
                help: "Attributes of an AgentRun that are not numbers."
                each:
                  type: Info
                  info:
                    labelsFromPath:
                      phase: [status, phase]
                      pod: [status, podName]
                      mode: [spec, mode]
                      model: [spec, model, model]
                      provider: [spec, model, provider]
              - name: created_timestamp_seconds
                help: "Time the AgentRun was created."
                each:
                  type: Gauge
                  gauge:
                    path: [metadata, creationTimestamp]
              - name: started_timestamp_seconds
                help: "Time the agent container started."
                each:
                  type: Gauge
                  gauge:
                    path: [status, startedAt]
              - name: completed_timestamp_seconds
                help: "Time the run reached a terminal phase."
                each:
                  type: Gauge
                  gauge:
                    path: [status, completedAt]
              - name: exit_code
                help: "Exit code of the agent container."
                each:
                  type: Gauge
                  gauge:
                    path: [status, exitCode]
              # Reported by the harness, so it excludes scheduling and pull time.
              - name: duration_milliseconds
                help: "Wall-clock duration the harness measured."
                each:
                  type: Gauge
                  gauge:
                    path: [status, tokenUsage, durationMs]
              - name: input_tokens
                help: "Prompt tokens the run consumed."
                each:
                  type: Gauge
                  gauge:
                    path: [status, tokenUsage, inputTokens]
              - name: output_tokens
                help: "Completion tokens the run produced."
                each:
                  type: Gauge
                  gauge:
                    path: [status, tokenUsage, outputTokens]
              - name: total_tokens
                help: "Input plus output tokens."
                each:
                  type: Gauge
                  gauge:
                    path: [status, tokenUsage, totalTokens]
              - name: tool_calls
                help: "Tool invocations the run made."
                each:
                  type: Gauge
                  gauge:
                    path: [status, tokenUsage, toolCalls]
              # Absent for providers missing from the pricing table; the
              # openrouter entry is added in ../../automation/values/sympozium.yaml.gotmpl.
              - name: cost_micro_usd
                help: "Estimated cost in millionths of a USD."
                each:
                  type: Gauge
                  gauge:
                    path: [status, costEstimate, amountMicro]

prometheus-node-exporter:
  # The filesystem excludes are the chart default: extraArgs replaces it
  # wholesale, so re-check them on a chart bump.
  extraArgs:
    - --collector.filesystem.mount-points-exclude=^/(dev|proc|sys|run/containerd/.+|var/lib/docker/.+|var/lib/kubelet/.+)($|/)
    - --collector.filesystem.fs-types-exclude=^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs|erofs)$
    - --collector.textfile.directory=/var/lib/node_exporter
    # unit-include keeps this from emitting ~1k series per node.
    - --collector.systemd
    - --collector.systemd.unit-include=^(k3s|k3s-agent|containerd|ssh|systemd-timesyncd|chrony|smartmontools|nut-server|nut-monitor|nut-driver@.+)\.service$

  # The systemd collector needs /run/systemd/private inside the container.
  extraHostVolumeMounts:
    - name: run-systemd
      hostPath: /run/systemd
      mountPath: /run/systemd
      readOnly: true
      mountPropagation: HostToContainer

  securityContext:
    fsGroup: 0
    runAsGroup: 0
    runAsNonRoot: false
    runAsUser: 0

  sidecars:
    - name: node-exporter-textfiles-smartmon
      image: ghcr.io/datahub-local/node-exporter-textfiles:{{ range $key,$value := .StateValues.container_image_version }}{{ if (eq $key "ghcr.io/datahub-local/node-exporter-textfiles") }}{{ $value }}{{ end }}{{ end }}
      env:
        - name: SCRIPTS
          value: "nutmon.py,smartmon.py,updates.py"
        - name: INTERVAL
          value: "60"
      resources:
        requests:
          cpu: 100m
          memory: 100Mi
      securityContext:
        privileged: true

  sidecarVolumeMount:
    - name: collector-textfiles
      mountPath: /var/lib/node_exporter/
      readOnly: false
    - name: collector-tmp
      mountPath: /tmp
      readOnly: false

  sidecarHostVolumeMounts:
    - name: host-dev
      hostPath: /dev
      mountPath: /dev

extraManifests:
  - apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      annotations:
        gethomepage.dev/enabled: "true"
        gethomepage.dev/name: "Prometheus"
        gethomepage.dev/pod-selector: "app.kubernetes.io/name=prometheus"
        gethomepage.dev/group: "Monitoring"
        gethomepage.dev/icon: "sh-prometheus"
        gethomepage.dev/href: "https://monitoring-prometheus.{{ .Values.gateway_hostname }}"
      name: "{{ $.Values.release_name }}-kube-pr-prometheus"
    spec:
      entryPoints:
        - websecure
      routes:
        - match: Host(`monitoring-prometheus.{{ .StateValues.gateway_hostname }}`)
          kind: Rule
          services:
            - name: "{{ $.Values.release_name }}-kube-pr-prometheus"
              port: http-web
          middlewares:
            - name: oauth2-proxy-auth
              namespace: security
        - match: Host(`monitoring-prometheus.{{ .StateValues.gateway_hostname }}`) && PathPrefix(`/oauth2/`)
          kind: Rule
          services:
            - name: oauth2-proxy
              namespace: security
              port: http
  - apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      annotations:
        gethomepage.dev/enabled: "true"
        gethomepage.dev/name: "Alertmanager"
        gethomepage.dev/pod-selector: "app.kubernetes.io/name=alertmanager"
        gethomepage.dev/group: "Monitoring"
        gethomepage.dev/icon: "sh-prometheus"
        gethomepage.dev/href: "https://monitoring-alertmanager.{{ .Values.gateway_hostname }}"
      name: "{{ $.Values.release_name }}-kube-pr-alertmanager"
    spec:
      entryPoints:
        - websecure
      routes:
        - match: Host(`monitoring-alertmanager.{{ .StateValues.gateway_hostname }}`)
          kind: Rule
          services:
            - name: "{{ $.Values.release_name }}-kube-pr-alertmanager"
              port: http-web
          middlewares:
            - name: oauth2-proxy-auth
              namespace: security
        - match: Host(`monitoring-alertmanager.{{ .StateValues.gateway_hostname }}`) && PathPrefix(`/oauth2/`)
          kind: Rule
          services:
            - name: oauth2-proxy
              namespace: security
              port: http
  - apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      annotations:
        gethomepage.dev/enabled: "true"
        gethomepage.dev/name: "Grafana"
        gethomepage.dev/pod-selector: "app.kubernetes.io/name=grafana"
        gethomepage.dev/group: "Monitoring"
        gethomepage.dev/icon: "sh-grafana"
        gethomepage.dev/href: "https://monitoring-grafana.{{ .Values.gateway_hostname }}"
      name: "{{ $.Values.release_name }}-kube-prometheus-stack-grafana"
    spec:
      entryPoints:
        - websecure
      routes:
        - match: Host(`monitoring-grafana.{{ .StateValues.gateway_hostname }}`)
          kind: Rule
          services:
            - name: "{{ $.Values.release_name }}-kube-prometheus-stack-grafana"
              port: http-web
