# https://github.com/community-charts/helm-charts/blob/main/charts/actualbudget/values.yaml

replicaCount: 1

image:
  repository: actualbudget/actual-server
  pullPolicy: IfNotPresent
  tag: '{{ range $key,$value := .StateValues.container_image_version }}{{ if (eq $key "actualbudget/actual-server") }}{{ $value }}{{ end }}{{ end }}'

persistence:
  enabled: true
  storageClass: longhorn
  size: 10Gi

# Login is configured entirely through env: the chart only renders its own
# ACTUAL_OPENID_* block when its ingress is enabled (this release uses a Traefik
# IngressRoute, so it is off), and its login.openid map exists only to satisfy the
# chart's schema. The chart still emits its default ACTUAL_LOGIN_METHOD=password and
# ACTUAL_ALLOWED_LOGIN_METHODS=password,header,openid before these, so the two below
# are duplicate env keys whose last value wins.
extraEnvVars:
  ACTUAL_LOGIN_METHOD: "openid"
  ACTUAL_ALLOWED_LOGIN_METHODS: "openid"
  ACTUAL_MULTIUSER: "true"
  ACTUAL_OPENID_ENFORCE: "true"
  ACTUAL_OPENID_PROVIDER_NAME: "IAM"
  ACTUAL_OPENID_DISCOVERY_URL: "https://security-dex.{{ .StateValues.gateway_hostname }}/dex/.well-known/openid-configuration"
  ACTUAL_OPENID_CLIENT_ID: "actualbudget"
  ACTUAL_OPENID_CLIENT_SECRET: "{{ .StateValues.security_github_client_secret }}"
  ACTUAL_OPENID_SERVER_HOSTNAME: "https://other-actualbudget.{{ .StateValues.gateway_hostname }}"
  ACTUAL_OPENID_AUTH_METHOD: "openid"
  ACTUAL_TOKEN_EXPIRATION: "never"
  ACTUAL_USER_CREATION_MODE: "login"

resources:
  requests:
    cpu: 25m
    memory: 128Mi
  limits:
    memory: 512Mi

podLabels:
  backup.velero.io/custom-backup-daily-fs: "true"

podAnnotations:
  backup.velero.io/backup-volumes: data
