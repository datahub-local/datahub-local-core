# Common values shared for all charts
---
cluster_name: homelab.alvsanand.com
release_name: datahub-local-core

#{{ $gateway_hostname := "homelab.alvsanand.com" }}
gateway_hostname: "{{ $gateway_hostname }}"
ingress_port: 443

security_enabled: true

postgres_extra_databases:
  airflow: airflow
  miniflux: miniflux
  n8n: n8n
  openwebui: openwebui
  polaris: polaris
  superset: superset

iceberg_catalogs:
  bronze: bronze
  silver: silver
  gold: gold
  test: test

#{{ $trino_mcp_user := "mcp" }}
#{{ $trino_dbt_user := "dbt" }}
#{{ $trino_superset_user := "superset" }}
#{{ $trino_maintenance_user := "maintenance" }}

# Read-only Trino identity for the agent MCP server, scoped in the Trino rules.
trino_mcp_user: "{{ $trino_mcp_user }}"
# Matches the TRINO_USER default in datahub-local-ai's dbt profiles.
trino_dbt_user: "{{ $trino_dbt_user }}"
# Superset's sqlalchemy_uri must be changed to this user for it to take effect.
trino_superset_user: "{{ $trino_superset_user }}"
# Iceberg schema creation and nightly table compaction (polaris-jobs).
trino_maintenance_user: "{{ $trino_maintenance_user }}"

# Trino access tiers, consumed by rules.json in trino.yaml.gotmpl.
# default_admin_user is a StateValue loaded after this file, so the template
# appends it to the admin tier.
trino_reader_users:
  - "{{ $trino_mcp_user }}"
trino_writer_users:
  - "{{ $trino_dbt_user }}"
  - "{{ $trino_superset_user }}"
  - "{{ $trino_maintenance_user }}"
trino_admin_extra_users: []

kopia_backup_namespaces:
  - automation
  - data
  - media
  - monitoring
  - security

s3_endpoint: "data-s3.homelab.alvsanand.com"
s3_buckets:
  - name: datahub-local-temp
s3_gdrive_endpoint: "data-s3-gdrive.homelab.alvsanand.com"
s3_gdrive_buckets:
  - name: datahub-local-gdrive-backup

backup_s3_bucket: datahub-local-gdrive-backup
backup_s3_region: homelab
