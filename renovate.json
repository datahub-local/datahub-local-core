{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>datahub-local/datahub-local-core:renovate-presets/default"],
  "ignorePaths": [
    "**/.devcontainer/**",
    "**/.github/**",
    "**/Dockerfile",
    "**/releases/**"
  ],
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": ["/(^|/)values/_version.yaml$/"],
      "matchStrings": [
        "$each(helm_chart_version, function($v, $k) { {'depName':$k, 'packageName': ($contains($v.repository, 'oci://'))?($replace($v.repository, 'oci://', '') & '/' & $k):$k, 'datasource': ($contains($v.repository, 'oci://'))?'docker':'helm', 'currentValue': $v.version, 'registryUrl': ($contains($v.repository, 'oci://'))?'':$v.repository} })"
      ]
    },
    {
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": ["/(^|/)values/_version.yaml$/"],
      "matchStrings": [
        "$each(container_image_version, function($v, $k) { {'packageName': $k , 'datasource': 'docker', 'currentValue': ($contains($string($v), '@') ? $substringBefore($string($v), '@') : $string($v)), 'currentDigest': ($contains($string($v), '@') ? $substringAfter($string($v), '@'))} })"
      ]
    }
  ]
}
